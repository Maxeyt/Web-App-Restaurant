@page
@model MaxFood.Pages.Category.DeleteModel
@{
    ViewData["Title"] = "Удалить категорию";
}

<h1>Удалить категорию</h1>

<div class="alert alert-danger">
    <h3>Вы уверены, что хотите удалить эту категорию?</h3>
    <p>Вместе с категорией будут удалены все подкатегории и блюда в ней.</p>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Category.CategoryName</dd>
        <dt class="col-sm-2">Описание</dt>
        <dd class="col-sm-10">@Model.Category.Description</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Category.CategoryId" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-page="/Menu/Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>  
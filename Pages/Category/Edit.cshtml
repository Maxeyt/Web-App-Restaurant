@page
@model MaxFood.Pages.Category.EditModel
@{
    ViewData["Title"] = "Редактирование категории";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaxFood</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', 'Segoe UI', 'Roboto', sans-serif !important;
            letter-spacing: -0.2px;
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e8f0ea 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .form-container {
            max-width: 550px;
            width: 100%;
            margin: 0 auto;
        }

        .form-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        .form-header {
            background: linear-gradient(135deg, #2b8c4a 0%, #1e6b38 100%);
            padding: 28px 30px;
            text-align: center;
        }

            .form-header h3 {
                margin: 0;
                font-size: 1.6rem;
                font-weight: 700;
                color: white;
                letter-spacing: -0.3px;
            }

            .form-header p {
                margin: 8px 0 0;
                font-size: 0.8rem;
                color: rgba(255,255,255,0.85);
            }

            .form-header i {
                font-size: 2rem;
                margin-bottom: 8px;
                display: block;
            }

        .form-body {
            padding: 30px;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.8rem;
            margin-bottom: 6px;
            color: #2c3e2f;
        }

        .form-control, .form-select {
            border-radius: 12px;
            border: 1.5px solid #e9ecef;
            padding: 10px 14px;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #2b8c4a;
                box-shadow: 0 0 0 3px rgba(43,140,74,0.1);
                outline: none;
            }

        .form-check-input:checked {
            background-color: #2b8c4a;
            border-color: #2b8c4a;
        }

        .btn-save {
            background: linear-gradient(135deg, #2b8c4a 0%, #236f3d 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            font-size: 0.9rem;
            color: white;
            transition: all 0.2s;
        }

            .btn-save:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(43,140,74,0.3);
            }

        .btn-cancel {
            background: #f8f9fa;
            border: 1.5px solid #dee2e6;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #6c757d;
            transition: all 0.2s;
        }

            .btn-cancel:hover {
                background: #e9ecef;
                border-color: #adb5bd;
            }

        .text-danger {
            font-size: 0.7rem;
            margin-top: 4px;
        }

        .icon-preview {
            text-align: center;
            margin-bottom: 20px;
        }

            .icon-preview span {
                font-size: 3rem;
                background: #f8f9fa;
                padding: 15px;
                border-radius: 50%;
                display: inline-block;
            }

        hr {
            margin: 20px 0;
            border-color: #e9ecef;
        }
    </style>
</head>
<body>
    <div class="form-container">
        <div class="form-card">
            <div class="form-header">
                <i class="bi bi-folder-plus"></i>
                <h3>Редактирование категории</h3>
                <p>Измените данные категории</p>
            </div>
            <div class="form-body">
                <form method="post" id="categoryForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Category.CategoryId" />

                    <div class="icon-preview">
                        <span id="iconPreview">📁</span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category.CategoryName" class="form-label">
                            <i class="bi bi-tag me-1"></i> Название категории <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Category.CategoryName" class="form-control" placeholder="Например: Пицца, Бургеры, Роллы" id="CategoryName" />
                        <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category.Description" class="form-label">
                            <i class="bi bi-text-paragraph me-1"></i> Описание
                        </label>
                        <textarea asp-for="Category.Description" class="form-control" rows="3" placeholder="Краткое описание категории..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category.DisplayOrder" class="form-label">
                            <i class="bi bi-sort-numeric-down me-1"></i> Порядок отображения
                        </label>
                        <input asp-for="Category.DisplayOrder" class="form-control" type="number" placeholder="1, 2, 3..." />
                        <small class="text-muted">Чем меньше число, тем выше в списке</small>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="Category.IsActive" class="form-check-input" />
                        <label asp-for="Category.IsActive" class="form-check-label">
                            <i class="bi bi-check-circle me-1"></i> Категория активна
                        </label>
                        <small class="text-muted d-block">Неактивные категории не отображаются на сайте</small>
                    </div>

                    <hr />

                    <div class="d-flex gap-3 justify-content-end">
                        <button type="button" class="btn-cancel" onclick="closeModal()">
                            <i class="bi bi-x-lg me-1"></i> Отмена
                        </button>
                        <button type="submit" class="btn-save">
                            <i class="bi bi-check-lg me-1"></i> Сохранить
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function closeModal() {
            if (window.parent && window.parent.location.reload) {
                window.parent.location.reload();
            } else {
                window.location.href = '/Category/Index';
            }
        }

        const iconMap = {
            'пицца': '🍕', 'пиццы': '🍕', 'pizza': '🍕',
            'бургер': '🍔', 'бургеры': '🍔', 'burger': '🍔',
            'ролл': '🍣', 'роллы': '🍣', 'суши': '🍣', 'sushi': '🍣',
            'лапша': '🍜', 'wok': '🍜', 'noodle': '🍜',
            'шашлык': '🔥', 'kebab': '🔥',
            'горячее': '🍳', 'hot': '🍳',
            'суп': '🥣', 'супы': '🥣', 'soup': '🥣',
            'салат': '🥗', 'салаты': '🥗', 'salad': '🥗',
            'закуска': '🍟', 'закуски': '🍟', 'snack': '🍟',
            'десерт': '🍰', 'десерты': '🍰', 'dessert': '🍰',
            'напиток': '🥤', 'напитки': '🥤', 'drink': '🥤'
        };

        function updateIconFromName(name) {
            var val = name.toLowerCase();
            for (var key in iconMap) {
                if (val.includes(key)) {
                    document.getElementById('iconPreview').textContent = iconMap[key];
                    return;
                }
            }
            document.getElementById('iconPreview').textContent = '📁';
        }

        var categoryNameInput = document.getElementById('CategoryName');
        if (categoryNameInput) {
            updateIconFromName(categoryNameInput.value);
            categoryNameInput.addEventListener('input', function() {
                updateIconFromName(this.value);
            });
        }
    </script>
</body>
</html>
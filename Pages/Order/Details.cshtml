@page
@model MaxFood.Pages.Order.DetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = $"Детали заказа №{Model.Order?.OrderId}";
    var role = HttpContext.Session.GetInt32("UserRole");
    var requestToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
    bool isAdmin = (role == 4);
    bool isManager = (role == 3);
    bool isCourier = (role == 2);
    bool canManage = (role == 4 || role == 3 || role == 2);
    bool canDelete = (role == 4 || role == 3);
    string selectedPointName = Model.Order?.SelectedPickupPointName ?? "ТРЦ 'City' (ул. Савушкина, 5)";
}

@if (Model.Order == null)
{
    <div class="container mt-5">
        <div class="alert alert-danger text-center">
            <h4><i class="bi bi-exclamation-triangle-fill me-2"></i>Заказ не найден</h4>
            <a href="/Order/Index" class="btn btn-outline-secondary mt-3">← Вернуться к заказам</a>
        </div>
    </div>
    return;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaxFood</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * { font-family: 'Segoe UI', 'Roboto', system-ui, sans-serif; letter-spacing: -0.2px; }
        body { background: #f5f7fa; padding: 20px; }
        .details-container { max-width: 1100px; margin: 0 auto; background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .page-header { margin-bottom: 24px; }
        .page-header h2 { font-weight: 700; font-size: 1.5rem; color: #1a2a3a; margin: 0; }
        .back-link { color: #2b8c4a; text-decoration: none; font-weight: 500; }
        .back-link:hover { text-decoration: underline; }
        .order-status-badge { display: inline-block; padding: 6px 16px; border-radius: 30px; font-size: 0.8rem; font-weight: 600; margin-left: 12px; }
        .status-new { background: #d4edda; color: #155724; }
        .status-ready { background: #cce5ff; color: #004085; }
        .status-completed { background: #e2e3e5; color: #383d41; }
        .status-cancelled { background: #f8d7da; color: #721c24; }
        .info-card { background: #f8f9fa; border-radius: 12px; border: 1px solid #e9ecef; overflow: hidden; margin-bottom: 20px; }
        .info-card-header { background: white; padding: 14px 20px; border-bottom: 1px solid #e9ecef; font-weight: 700; font-size: 0.9rem; }
        .info-card-header i { margin-right: 8px; color: #2b8c4a; }
        .info-card-body { padding: 20px; background: white; }
        .info-row { display: flex; margin-bottom: 12px; flex-wrap: wrap; }
        .info-label { width: 130px; font-weight: 600; color: #495057; font-size: 0.85rem; }
        .info-value { flex: 1; font-size: 0.85rem; color: #212529; }
        .total-amount { font-size: 1.8rem; font-weight: 700; color: #2b8c4a; }
        .btn-action { padding: 10px 24px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; transition: all 0.2s; cursor: pointer; border: none; }
        .btn-success-custom { background: #2b8c4a; color: white; }
        .btn-success-custom:hover { background: #1e6b38; transform: translateY(-1px); }
        .btn-danger-custom { background: #dc3545; color: white; }
        .btn-danger-custom:hover { background: #b02a37; transform: translateY(-1px); }
        .btn-complete-custom { background: #17a2b8; color: white; }
        .btn-complete-custom:hover { background: #138496; transform: translateY(-1px); }
        .btn-outline-secondary-custom { border: 1px solid #6c757d; background: transparent; color: #6c757d; }
        .btn-outline-secondary-custom:hover { background: #6c757d; color: white; }
        .receipt-card { background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%); border-radius: 12px; border: 1px solid #e9ecef; }
        .receipt-card .info-card-header { background: #2b8c4a; color: white; border-bottom: none; border-radius: 12px 12px 0 0; }
        .receipt-card .info-card-header i { color: white; }
        .dish-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #e9ecef; }
        .dish-item:last-child { border-bottom: none; }
        .dish-name { font-weight: 600; font-size: 0.9rem; }
        .dish-quantity { color: #6c757d; font-size: 0.8rem; }
        .dish-price { font-weight: 600; color: #2b8c4a; }
        .two-columns { display: flex; gap: 24px; flex-wrap: wrap; }
        .left-column { flex: 1.5; min-width: 280px; }
        .right-column { flex: 0.9; min-width: 240px; }
        @@media (max-width: 768px) {
            .two-columns { flex-direction: column; }
            .info-label { width: 110px; }
            .details-container { padding: 16px; }
        }
        @@media print {
            body { background: white; padding: 0; margin: 0; }
            .details-container { box-shadow: none; padding: 0; margin: 0; max-width: 100%; }
            .btn-action, .back-link, .page-header .d-flex { display: none !important; }
            .order-status-badge { border: 1px solid #ccc; }
        }
    </style>
</head>
<body>
    <input type="hidden" id="__RequestVerificationToken" value="@requestToken" />

    <div class="details-container" id="receiptContainer">
        <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <a href="/Order/Index" class="back-link"><i class="bi bi-arrow-left"></i> Назад к заказам</a>
                <h2 class="mt-2">
                    Заказ №@Model.Order.OrderId
                    <span class="order-status-badge @(Model.Order.Status switch {
                        "Новый" => "status-new",
                        "Готов" => "status-ready",
                        "Завершен" => "status-completed",
                        "Завершён" => "status-completed",
                        "Отменен" => "status-cancelled",
                        "Отменён" => "status-cancelled",
                        _ => "status-new"
                    })">
                        @{
                            string displayStatus = Model.Order.Status switch
                            {
                                "Новый" => "Новый",
                                "Готов" => "Готов",
                                "Завершен" => "Завершён",
                                "Завершён" => "Завершён",
                                "Отменен" => "Отменён",
                                "Отменён" => "Отменён",
                                _ => Model.Order.Status
                            };
                        }
                        @displayStatus
                    </span>
                </h2>
            </div>
            @if (canManage)
            {
                <div class="d-flex gap-2">
                    @if (Model.Order.Status == "Новый")
                    {
                        <button class="btn-action btn-success-custom" id="markAsReadyBtn">
                            <i class="bi bi-check2-circle"></i> Отметить готовым
                        </button>
                    }
                    @if (Model.Order.Status == "Готов")
                    {
                        <button class="btn-action btn-complete-custom" id="completeOrderBtn">
                            <i class="bi bi-check-all"></i> Завершить заказ
                        </button>
                    }
                    @if (canDelete && Model.Order.Status != "Отменен" && Model.Order.Status != "Отменён" && Model.Order.Status != "Завершен" && Model.Order.Status != "Завершён")
                    {
                        <button class="btn-action btn-danger-custom" id="cancelOrderBtn">
                            <i class="bi bi-x-circle"></i> Отменить заказ
                        </button>
                    }
                </div>
            }
        </div>

        <div class="two-columns">
            <div class="left-column">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-info-circle-fill"></i> Информация о заказе
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <div class="info-label">Дата заказа:</div>
                            <div class="info-value">@Model.Order.OrderDate.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Клиент:</div>
                            <div class="info-value">@Model.Order.CustomerName</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Телефон:</div>
                            <div class="info-value">@Model.Order.CustomerPhone</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Способ получения:</div>
                            <div class="info-value">@Model.Order.DeliveryMethod</div>
                        </div>
                        @if (Model.Order.DeliveryMethod == "Самовывоз")
                        {
                            <div class="info-row">
                                <div class="info-label">Точка самовывоза:</div>
                                <div class="info-value"><strong>@selectedPointName</strong></div>
                            </div>
                        }
                        else
                        {
                            <div class="info-row">
                                <div class="info-label">Адрес доставки:</div>
                                <div class="info-value">@Model.Order.DeliveryAddress</div>
                            </div>
                            if (!string.IsNullOrEmpty(Model.Order.DeliveryComment))
                            {
                                <div class="info-row">
                                    <div class="info-label">Комментарий курьеру:</div>
                                    <div class="info-value">@Model.Order.DeliveryComment</div>
                                </div>
                            }
                        }
                        @if (!string.IsNullOrEmpty(Model.Order.Comment))
                        {
                            <div class="info-row">
                                <div class="info-label">Комментарий:</div>
                                <div class="info-value">@Model.Order.Comment</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="right-column">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-calculator-fill"></i> Итого
                    </div>
                    <div class="info-card-body text-center">
                        <div class="total-amount">@Model.Order.TotalAmount.ToString("N2") ₽</div>
                    </div>
                </div>

                <div class="receipt-card">
                    <div class="info-card-header">
                        <i class="bi bi-printer-fill"></i> Скачать документ заказа
                    </div>
                    <div class="info-card-body text-center">
                        <button class="btn-action btn-outline-secondary-custom w-100" id="downloadReceiptBtn">
                            <i class="bi bi-download me-2"></i> Скачать чек
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="info-card mt-3">
            <div class="info-card-header">
                <i class="bi bi-basket-fill"></i> Состав заказа
            </div>
            <div class="info-card-body">
                @if (Model.OrderItems == null || !Model.OrderItems.Any())
                {
                    <div class="text-center text-muted py-3">
                        <i class="bi bi-cart-x"></i> Состав заказа не найден
                    </div>
                }
                else
                {
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="dish-item">
                            <div>
                                <div class="dish-name">@item.DishName</div>
                                <div class="dish-quantity">Количество: @item.Quantity</div>
                            </div>
                            <div class="dish-price">@((item.Price * item.Quantity).ToString("N2")) ₽</div>
                        </div>
                    }
                    <div class="dish-item mt-2 pt-2" style="border-top: 2px solid #e9ecef;">
                        <div class="fw-bold">Итого:</div>
                        <div class="fw-bold text-success">@Model.Order.TotalAmount.ToString("N2") ₽</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function getToken() { return document.getElementById('__RequestVerificationToken')?.value || ''; }
        
        function showNotification(msg, type) {
            var n = document.createElement('div');
            n.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger') + ' position-fixed top-0 end-0 m-3';
            n.style.zIndex = '9999';
            n.style.borderRadius = '12px';
            n.innerHTML = '<i class="bi bi-' + (type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill') + ' me-2"></i> ' + msg;
            document.body.appendChild(n);
            setTimeout(function() { n.remove(); }, 3000);
        }

        var orderId = @Model.Order.OrderId;

        // Отметить готовым
        var readyBtn = document.getElementById('markAsReadyBtn');
        if (readyBtn) {
            readyBtn.addEventListener('click', async function() {
                if (!confirm('Отметить заказ как готовый?')) return;
                try {
                    var resp = await fetch('/Order/Details?handler=MarkAsReady', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json', 
                            'RequestVerificationToken': getToken(),
                            'X-CSRF-TOKEN': getToken()
                        },
                        body: JSON.stringify({ orderId: orderId })
                    });
                    var result = await resp.json();
                    if (result.success) {
                        showNotification('Заказ отмечен как готовый', 'success');
                        setTimeout(function() { location.reload(); }, 1000);
                    } else {
                        showNotification(result.message || 'Ошибка', 'danger');
                    }
                } catch(e) { 
                    console.error(e);
                    showNotification('Ошибка соединения', 'danger'); 
                }
            });
        }

        // Завершить заказ
        var completeBtn = document.getElementById('completeOrderBtn');
        if (completeBtn) {
            completeBtn.addEventListener('click', async function() {
                if (!confirm('Завершить заказ? Заказ будет отмечен как выполненный.')) return;
                try {
                    var resp = await fetch('/Order/Details?handler=CompleteOrder', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json', 
                            'RequestVerificationToken': getToken(),
                            'X-CSRF-TOKEN': getToken()
                        },
                        body: JSON.stringify({ orderId: orderId })
                    });
                    var result = await resp.json();
                    if (result.success) {
                        showNotification('Заказ завершён', 'success');
                        setTimeout(function() { location.reload(); }, 1000);
                    } else {
                        showNotification(result.message || 'Ошибка', 'danger');
                    }
                } catch(e) { 
                    console.error(e);
                    showNotification('Ошибка соединения', 'danger'); 
                }
            });
        }

        // Отменить заказ
        var cancelBtn = document.getElementById('cancelOrderBtn');
        if (cancelBtn) {
            cancelBtn.addEventListener('click', async function() {
                if (!confirm('Отменить заказ? Это действие необратимо.')) return;
                try {
                    var resp = await fetch('/Order/Details?handler=CancelOrder', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json', 
                            'RequestVerificationToken': getToken(),
                            'X-CSRF-TOKEN': getToken()
                        },
                        body: JSON.stringify({ orderId: orderId })
                    });
                    var result = await resp.json();
                    if (result.success) {
                        showNotification('Заказ отменён', 'success');
                        setTimeout(function() { location.reload(); }, 1000);
                    } else {
                        showNotification(result.message || 'Ошибка', 'danger');
                    }
                } catch(e) { 
                    console.error(e);
                    showNotification('Ошибка соединения', 'danger'); 
                }
            });
        }

        // Скачать чек
        var receiptBtn = document.getElementById('downloadReceiptBtn');
        if (receiptBtn) {
            receiptBtn.addEventListener('click', function() {
                window.open('/Order/Details?handler=DownloadReceiptFull&id=' + orderId, '_blank');
            });
        }
    </script>
</body>
</html>
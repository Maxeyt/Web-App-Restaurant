    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://api-maps.yandex.ru/2.1/?apikey=4530ebd5-c3bd-4620-9f04-530dc4d2f48b&lang=ru_RU"></script>
    <script>
        const bonusBalance = @Model.BonusBalance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        const totalAmount = @Model.TotalAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        let currentBonusSpend = 0, currentPromoCode = '', promoDiscount = 0, maxBonusSpend = Math.floor(totalAmount * 0.3);
        let currentTab = 'delivery';
        let yandexMap = null, searchPlacemark = null;
        let allMapLocations = [];
        
        // Массив для хранения всех промокодов пользователя
        let allUserPromoCodes = [];

        @foreach (var point in pickupPoints)
        {
            if (point.Latitude.HasValue && point.Longitude.HasValue)
            {
                @:allMapLocations.push({ id: @point.PointPickupId, name: '@point.PointName', address: '@point.Address', latitude: @point.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), longitude: @point.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) });
            }
        }

        function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }

        function showNotification(message, type) {
            var n = document.createElement('div');
            n.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger') + ' position-fixed top-0 end-0 m-3';
            n.style.zIndex = '9999';
            n.style.borderRadius = '12px';
            n.style.fontWeight = '600';
            n.innerHTML = '<i class="bi bi-' + (type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill') + ' me-2"></i> ' + message;
            document.body.appendChild(n);
            setTimeout(function() { n.remove(); }, 3000);
        }

        // ========== ЗАГРУЗКА ПРОМОКОДОВ ПОЛЬЗОВАТЕЛЯ ==========
        async function loadUserPromoCodes() {
            try {
                const response = await fetch('/Order/Create?handler=UserPromoCodes');
                if (response.ok) {
                    allUserPromoCodes = await response.json();
                    console.log('Загружены промокоды:', allUserPromoCodes);
                }
            } catch (e) {
                console.error('Ошибка загрузки промокодов:', e);
            }
        }

        // ========== ПОКАЗ ПОДСКАЗОК ПРОМОКОДОВ ==========
        function showPromoSuggestions() {
            const input = document.getElementById('promoCodeInput');
            const suggestionsDiv = document.getElementById('promoSuggestions');
            if (!input || !suggestionsDiv) return;
            
            const query = input.value.trim().toUpperCase();
            
            if (!allUserPromoCodes.length || query.length === 0) {
                suggestionsDiv.style.display = 'none';
                return;
            }
            
            const filtered = allUserPromoCodes.filter(function(code) {
                return code.toUpperCase().includes(query);
            });
            
            if (filtered.length === 0) {
                suggestionsDiv.style.display = 'none';
                return;
            }
            
            let html = '';
            for (var i = 0; i < filtered.length; i++) {
                var code = filtered[i];
                var escapedCode = code.replace(/'/g, "\\'");
                html += '<div class="suggestion-item" onclick="selectPromoSuggestion(\'' + escapedCode + '\')">';
                html += '<span class="suggestion-code">' + code + '</span>';
                html += '<span class="suggestion-badge"><i class="bi bi-ticket-perforated"></i> Промокод</span>';
                html += '</div>';
            }
            suggestionsDiv.innerHTML = html;
            suggestionsDiv.style.display = 'block';
        }

        // ========== ВЫБОР ПРОМОКОДА ИЗ ПОДСКАЗКИ ==========
        function selectPromoSuggestion(code) {
            const input = document.getElementById('promoCodeInput');
            const suggestionsDiv = document.getElementById('promoSuggestions');
            if (input) input.value = code;
            if (suggestionsDiv) suggestionsDiv.style.display = 'none';
            applyPromoCode();
        }

        function initMap() {
            const mapContainer = document.getElementById('yandexMap');
            if (!mapContainer) return;
            if (typeof ymaps === 'undefined') { setTimeout(initMap, 500); return; }
            ymaps.ready(function() {
                try {
                    yandexMap = new ymaps.Map('yandexMap', {
                        center: [46.3497, 48.0408],
                        zoom: 13,
                        controls: ['zoomControl', 'fullscreenControl'],
                        suppressMapOpenBlock: true
                    });
                    if (allMapLocations && allMapLocations.length) {
                        for (var i = 0; i < allMapLocations.length; i++) {
                            var loc = allMapLocations[i];
                            if (loc.latitude && loc.longitude) {
                                var placemark = new ymaps.Placemark([loc.latitude, loc.longitude], {
                                    balloonContentHeader: '<strong>' + loc.name + '</strong>',
                                    balloonContentBody: loc.address,
                                    hintContent: loc.name
                                }, { preset: 'islands#redIcon' });
                                placemark.events.add('click', function(locId, locAddress, locLat, locLon) {
                                    return function() {
                                        selectPickupPoint(locId, locAddress, null, locLat, locLon);
                                    };
                                }(loc.id, loc.address, loc.latitude, loc.longitude));
                                yandexMap.geoObjects.add(placemark);
                            }
                        }
                    }
                } catch(e) { console.error('Map error:', e); }
            });
        }

        function searchOnMap() {
            var searchText = document.getElementById('mapSearchInput')?.value;
            if (!searchText || !yandexMap) return;
            if (searchPlacemark) yandexMap.geoObjects.remove(searchPlacemark);
            ymaps.geocode(searchText + ', Астрахань', { results: 1 }).then(function(res) {
                var geo = res.geoObjects.get(0);
                if (geo) {
                    var coords = geo.geometry.getCoordinates();
                    var address = geo.getAddressLine();
                    searchPlacemark = new ymaps.Placemark(coords, { balloonContentBody: address }, { preset: 'islands#blueIcon' });
                    yandexMap.geoObjects.add(searchPlacemark);
                    yandexMap.setCenter(coords, 15);
                    searchPlacemark.balloon.open();
                }
            });
        }

        let debounceTimer;
        var searchInputMap = document.getElementById('mapSearchInput');
        if (searchInputMap) {
            searchInputMap.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                var q = this.value.trim();
                if (q.length < 2) { hideSuggestions(); return; }
                debounceTimer = setTimeout(function() {
                    ymaps.geocode('Астрахань, ' + q, { results: 5 }).then(function(res) {
                        var items = res.geoObjects.toArray();
                        var cont = document.getElementById('searchSuggestions');
                        if (!items.length) { hideSuggestions(); return; }
                        var html = '';
                        for (var i = 0; i < items.length; i++) {
                            var a = items[i].getAddressLine();
                            var escapedA = a.replace(/'/g, "\\'");
                            html += '<div class="suggestion-item" onclick="selectSuggestion(\'' + escapedA + '\')">📍 ' + a + '</div>';
                        }
                        cont.innerHTML = html;
                        cont.classList.add('show');
                    });
                }, 300);
            });
            searchInputMap.addEventListener('keydown', function(e) { if (e.key === 'Enter') searchOnMap(); });
            document.addEventListener('click', function(e) { if (!e.target.closest('.search-wrapper')) hideSuggestions(); });
        }

        function selectSuggestion(a) {
            var si = document.getElementById('mapSearchInput');
            if (si) si.value = a;
            if (yandexMap) {
                ymaps.geocode(a, { results: 1 }).then(function(res) {
                    var geo = res.geoObjects.get(0);
                    if (geo && yandexMap) {
                        var coords = geo.geometry.getCoordinates();
                        yandexMap.setCenter(coords, 15);
                        if (searchPlacemark) yandexMap.geoObjects.remove(searchPlacemark);
                        searchPlacemark = new ymaps.Placemark(coords, { balloonContentBody: a }, { preset: 'islands#blueIcon' });
                        yandexMap.geoObjects.add(searchPlacemark);
                        searchPlacemark.balloon.open();
                    }
                });
            }
            hideSuggestions();
        }

        function hideSuggestions() {
            var c = document.getElementById('searchSuggestions');
            if (c) { c.classList.remove('show'); c.innerHTML = ''; }
        }

        async function selectPickupPoint(pointId, address, element, lat, lon) {
            try {
                var resp = await fetch(window.location.pathname + '?handler=TogglePickupPoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                    body: JSON.stringify({ pointPickupId: pointId })
                });
                var result = await resp.json();
                if (result.success) {
                    if (result.selected) {
                        var pills = document.querySelectorAll('.address-pill');
                        for (var i = 0; i < pills.length; i++) {
                            pills[i].classList.remove('selected');
                        }
                        if (element) element.classList.add('selected');
                        document.getElementById('pointPickupHidden').value = pointId;
                        showNotification('Точка самовывоза выбрана', 'success');
                        
                        if (yandexMap && lat && lon) {
                            yandexMap.setCenter([lat, lon], 15);
                            if (searchPlacemark) yandexMap.geoObjects.remove(searchPlacemark);
                        }
                    } else {
                        if (element) element.classList.remove('selected');
                        document.getElementById('pointPickupHidden').value = '';
                    }
                }
            } catch(e) { console.error(e); }
        }

        function handleCvvKeyDown(e) {
            var input = e.target;
            var key = e.key;
            var currentRaw = input.getAttribute('data-raw-value') || '';
            var start = input.selectionStart;
            var end = input.selectionEnd;
            var hasSelection = (start !== end);

            if (key === 'ArrowLeft' || key === 'ArrowRight' || key === 'Tab' || key === 'Home' || key === 'End') {
                return;
            }

            if (key === 'Backspace') {
                e.preventDefault();
                var newRaw = currentRaw;
                if (hasSelection) {
                    newRaw = currentRaw.slice(0, start) + currentRaw.slice(end);
                } else if (start > 0) {
                    newRaw = currentRaw.slice(0, start - 1) + currentRaw.slice(start);
                }
                input.setAttribute('data-raw-value', newRaw);
                var masked = '';
                for (var i = 0; i < newRaw.length; i++) { masked += '*'; }
                input.value = masked;
                var newPos = hasSelection ? start : Math.max(0, start - 1);
                input.setSelectionRange(newPos, newPos);
                return;
            }

            if (key === 'Delete') {
                e.preventDefault();
                var newRaw = currentRaw;
                if (hasSelection) {
                    newRaw = currentRaw.slice(0, start) + currentRaw.slice(end);
                } else if (start < currentRaw.length) {
                    newRaw = currentRaw.slice(0, start) + currentRaw.slice(start + 1);
                }
                input.setAttribute('data-raw-value', newRaw);
                var masked = '';
                for (var i = 0; i < newRaw.length; i++) { masked += '*'; }
                input.value = masked;
                input.setSelectionRange(start, start);
                return;
            }

            if (key.length === 1 && /[0-9]/.test(key)) {
                e.preventDefault();
                var newRaw = currentRaw;
                if (hasSelection) {
                    newRaw = currentRaw.slice(0, start) + key + currentRaw.slice(end);
                } else {
                    newRaw = currentRaw.slice(0, start) + key + currentRaw.slice(start);
                }
                if (newRaw.length > 3) { newRaw = newRaw.substring(0, 3); }
                input.setAttribute('data-raw-value', newRaw);
                var masked = '';
                for (var i = 0; i < newRaw.length; i++) { masked += '*'; }
                input.value = masked;
                var newPos = hasSelection ? start + 1 : start + 1;
                if (newPos > masked.length) newPos = masked.length;
                input.setSelectionRange(newPos, newPos);
                return;
            }

            if (key !== 'Tab' && key !== 'Shift' && key !== 'Control' && key !== 'Alt' && key !== 'Meta') {
                e.preventDefault();
            }
        }

        function reorderAddressCards() {
            var container = document.getElementById('savedAddressesContainer');
            if (!container) return;
            var cards = Array.from(container.querySelectorAll('.address-card'));
            cards.sort(function(a, b) {
                var aDefault = a.classList.contains('default') ? 1 : 0;
                var bDefault = b.classList.contains('default') ? 1 : 0;
                return bDefault - aDefault;
            });
            for (var i = 0; i < cards.length; i++) {
                container.appendChild(cards[i]);
            }
        }

        function reorderPaymentCards() {
            var container = document.getElementById('paymentsContainer');
            if (!container) return;
            var cards = Array.from(container.querySelectorAll('.payment-card'));
            cards.sort(function(a, b) {
                var aDefault = a.classList.contains('default') ? 1 : 0;
                var bDefault = b.classList.contains('default') ? 1 : 0;
                return bDefault - aDefault;
            });
            for (var i = 0; i < cards.length; i++) {
                container.appendChild(cards[i]);
            }
        }

        function updateMaxBonus() {
            var s = totalAmount - promoDiscount;
            maxBonusSpend = Math.min(Math.floor(s * 0.3), bonusBalance);
            document.getElementById('maxBonusSpend').textContent = maxBonusSpend.toLocaleString();
            document.getElementById('bonusRange').max = maxBonusSpend;
            updateBonusSpend(document.getElementById('bonusRange').value);
        }

        function updateBonusSpend(v) {
            currentBonusSpend = parseInt(v) || 0;
            document.getElementById('bonusSpendDisplay').textContent = currentBonusSpend.toLocaleString();
            document.getElementById('bonusToSpendHidden').value = currentBonusSpend;
            recalculateTotal();
        }

        async function applyPromoCode() {
            var c = document.getElementById('promoCodeInput').value.trim();
            var promoMessageDiv = document.getElementById('promoMessage');
            var promoErrorDiv = document.getElementById('promoError');
            if (promoMessageDiv) promoMessageDiv.style.display = 'none';
            if (promoErrorDiv) promoErrorDiv.style.display = 'none';
            
            if (!c) {
                currentPromoCode = '';
                promoDiscount = 0;
                document.getElementById('promoCodeHidden').value = '';
                updateMaxBonus();
                recalculateTotal();
                return;
            }
            try {
                var r = await fetch('/Order/Create?handler=CheckPromoCode&code=' + encodeURIComponent(c));
                var d = await r.json();
                if (d.success) {
                    currentPromoCode = c;
                    promoDiscount = Math.round(totalAmount * d.discountPercent / 100);
                    document.getElementById('promoCodeHidden').value = c;
                    if (promoMessageDiv) {
                        promoMessageDiv.textContent = 'Промокод применён! Скидка ' + d.discountPercent + '%';
                        promoMessageDiv.style.display = 'block';
                    }
                    updateMaxBonus();
                    recalculateTotal();
                } else {
                    if (promoErrorDiv) {
                        promoErrorDiv.textContent = d.message || 'Промокод недействителен';
                        promoErrorDiv.style.display = 'block';
                    }
                }
            } catch(e) {
                if (promoErrorDiv) {
                    promoErrorDiv.textContent = 'Ошибка проверки';
                    promoErrorDiv.style.display = 'block';
                }
            }
        }

        function recalculateTotal() {
            var f = totalAmount - promoDiscount - currentBonusSpend;
            var d = f > 0 ? f : 0;
            document.getElementById('finalTotalHidden').value = d;
            document.getElementById('totalAmount').textContent = d.toLocaleString('ru-RU', { style: 'currency', currency: 'RUB' });
            document.getElementById('submitTotal').textContent = d.toLocaleString('ru-RU', { style: 'currency', currency: 'RUB' });
        }

        async function toggleDefaultAddress(checkbox) {
            var addressId = parseInt(checkbox.getAttribute('data-address-id'));
            var isChecked = checkbox.checked;
            try {
                var resp = await fetch(window.location.pathname + '?handler=ToggleDefaultAddress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                    body: JSON.stringify({ addressId: addressId, isDefault: isChecked })
                });
                if (!resp.ok) throw new Error('HTTP error ' + resp.status);
                var result = await resp.json();
                if (result.success) {
                    if (isChecked) {
                        var cards = document.querySelectorAll('.address-card');
                        for (var i = 0; i < cards.length; i++) {
                            cards[i].classList.remove('default');
                            cards[i].setAttribute('data-isdefault', 'false');
                        }
                        var checkboxes = document.querySelectorAll('.default-checkbox');
                        for (var i = 0; i < checkboxes.length; i++) {
                            if (checkboxes[i] !== checkbox) checkboxes[i].checked = false;
                        }
                        var selectedCard = document.getElementById('address-' + addressId);
                        if (selectedCard) {
                            selectedCard.classList.add('default');
                            selectedCard.setAttribute('data-isdefault', 'true');
                            var city = selectedCard.getAttribute('data-city') || '';
                            var fullAddress = selectedCard.getAttribute('data-street') || '';
                            var entrance = selectedCard.getAttribute('data-entrance') || '';
                            var floor = selectedCard.getAttribute('data-floor') || '';
                            var apartment = selectedCard.getAttribute('data-apartment') || '';
                            var domofon = selectedCard.getAttribute('data-domofon') || '';
                            var details = [];
                            if (entrance && entrance !== '') details.push('подъезд ' + entrance);
                            if (floor && floor !== '0' && floor !== '') details.push('этаж ' + floor);
                            if (domofon && domofon !== '') details.push('домофон ' + domofon);
                            if (apartment && apartment !== '') details.push('кв. ' + apartment);
                            var fullWithDetails = (city ? city + ', ' : '') + fullAddress + (details.length ? ', ' + details.join(', ') : '');
                            document.getElementById('deliveryAddressHidden').value = fullWithDetails;
                        }
                    } else {
                        var card = document.getElementById('address-' + addressId);
                        if (card) {
                            card.classList.remove('default');
                            card.setAttribute('data-isdefault', 'false');
                        }
                    }
                    reorderAddressCards();
                    showNotification(isChecked ? 'Адрес установлен как основной' : 'Основной адрес снят', 'success');
                } else {
                    checkbox.checked = !isChecked;
                    showNotification(result.message || 'Ошибка', 'danger');
                }
            } catch(e) {
                console.error(e);
                checkbox.checked = !isChecked;
                showNotification('Ошибка при изменении основного адреса', 'danger');
            }
        }

        async function toggleDefaultPayment(checkbox) {
            var paymentId = parseInt(checkbox.getAttribute('data-payment-id'));
            var isChecked = checkbox.checked;
            try {
                var resp = await fetch(window.location.pathname + '?handler=ToggleDefaultPayment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                    body: JSON.stringify({ paymentId: paymentId, isDefault: isChecked })
                });
                if (!resp.ok) throw new Error('HTTP error ' + resp.status);
                var result = await resp.json();
                if (result.success) {
                    if (isChecked) {
                        var cards = document.querySelectorAll('.payment-card');
                        for (var i = 0; i < cards.length; i++) {
                            cards[i].classList.remove('default');
                            cards[i].setAttribute('data-isdefault', 'false');
                        }
                        var checkboxes = document.querySelectorAll('.default-payment-checkbox');
                        for (var i = 0; i < checkboxes.length; i++) {
                            if (checkboxes[i] !== checkbox) checkboxes[i].checked = false;
                        }
                        var selectedCard = document.getElementById('payment-' + paymentId);
                        if (selectedCard) {
                            selectedCard.classList.add('default');
                            selectedCard.setAttribute('data-isdefault', 'true');
                            document.getElementById('selectedPaymentIdHidden').value = paymentId;
                        }
                    } else {
                        var card = document.getElementById('payment-' + paymentId);
                        if (card) {
                            card.classList.remove('default');
                            card.setAttribute('data-isdefault', 'false');
                        }
                    }
                    reorderPaymentCards();
                    showNotification(isChecked ? 'Карта установлена как основная' : 'Основная карта снята', 'success');
                } else {
                    checkbox.checked = !isChecked;
                    showNotification(result.message || 'Ошибка', 'danger');
                }
            } catch(e) {
                console.error(e);
                checkbox.checked = !isChecked;
                showNotification('Ошибка при изменении основной карты', 'danger');
            }
        }

        function editAddress(id) {
            var card = document.getElementById('address-' + id);
            if (!card) return;
            document.getElementById('addressModalTitle').textContent = 'Изменение адреса';
            document.getElementById('editAddressId').value = id;
            var city = card.getAttribute('data-city') || '';
            var fullAddress = card.getAttribute('data-street') || '';
            var entrance = card.getAttribute('data-entrance') || '';
            var floor = card.getAttribute('data-floor') || '';
            var apartment = card.getAttribute('data-apartment') || '';
            var domofon = card.getAttribute('data-domofon') || '';
            var comment = card.getAttribute('data-comment') || '';
            var isDefault = card.getAttribute('data-isdefault') === 'true';
            var street = fullAddress, house = '', building = '';
            if (fullAddress.includes(', д.')) {
                var parts = fullAddress.split(', д.');
                street = parts[0];
                house = parts[1]?.split(', к.')[0] || '';
                building = parts[1]?.split(', к.')[1] || '';
            }
            document.getElementById('editCity').value = city;
            document.getElementById('editStreet').value = street;
            document.getElementById('editHouse').value = house;
            document.getElementById('editBuilding').value = building;
            document.getElementById('editEntrance').value = entrance;
            document.getElementById('editFloor').value = floor;
            document.getElementById('editApartment').value = apartment;
            document.getElementById('editDomofon').value = domofon;
            document.getElementById('editComment').value = comment;
            document.getElementById('editIsDefault').checked = isDefault;
            var modal = new bootstrap.Modal(document.getElementById('addressModal'));
            modal.show();
        }

        async function deleteAddress(id) {
            if (!confirm('Удалить адрес?')) return;
            try {
                var resp = await fetch(window.location.pathname + '?handler=DeleteDeliveryAddress&id=' + id, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': getToken() }
                });
                var result = await resp.json();
                if (result.success) location.reload();
                else showNotification(result.message || 'Ошибка удаления', 'danger');
            } catch(e) { showNotification('Ошибка удаления', 'danger'); }
        }

        function openNewAddressModal() {
            document.getElementById('addressModalTitle').textContent = 'Добавление адреса';
            document.getElementById('editAddressId').value = '0';
            document.getElementById('editCity').value = '';
            document.getElementById('editStreet').value = '';
            document.getElementById('editHouse').value = '';
            document.getElementById('editBuilding').value = '';
            document.getElementById('editEntrance').value = '';
            document.getElementById('editFloor').value = '';
            document.getElementById('editApartment').value = '';
            document.getElementById('editDomofon').value = '';
            document.getElementById('editComment').value = '';
            document.getElementById('editIsDefault').checked = false;
            var modal = new bootstrap.Modal(document.getElementById('addressModal'));
            modal.show();
        }

        async function saveAddress() {
            var city = document.getElementById('editCity').value.trim();
            var street = document.getElementById('editStreet').value.trim();
            var house = document.getElementById('editHouse').value.trim();
            if (!street || !house) { alert('Введите улицу и дом'); return; }
            if (!city) { alert('Введите город'); return; }
            var building = document.getElementById('editBuilding').value.trim();
            var full = street + ', д. ' + house + (building ? ', к. ' + building : '');
            var data = {
                addressId: parseInt(document.getElementById('editAddressId').value) || null,
                city: city,
                street: full,
                apartment: document.getElementById('editApartment').value.trim() || null,
                entrance: document.getElementById('editEntrance').value.trim() || null,
                floor: parseInt(document.getElementById('editFloor').value) || null,
                domofon: document.getElementById('editDomofon').value.trim() || null,
                comment: document.getElementById('editComment').value.trim() || null,
                isDefault: document.getElementById('editIsDefault').checked
            };
            try {
                var resp = await fetch(window.location.pathname + '?handler=SaveDeliveryAddress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                    body: JSON.stringify(data)
                });
                var result = await resp.json();
                if (result.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('addressModal'));
                    if (modal) modal.hide();
                    location.reload();
                } else alert(result.message || 'Ошибка');
            } catch(e) { alert('Ошибка при сохранении'); }
        }

        function maskCardNumber(input) {
            var v = input.value.replace(/\D/g, '').substring(0, 16);
            var f = '';
            for (var i = 0; i < v.length; i++) {
                if (i > 0 && i % 4 === 0) f += ' ';
                f += v[i];
            }
            input.value = f;
        }

        function maskExpiryDate(input) {
            var v = input.value.replace(/\D/g, '').substring(0, 4);
            if (v.length >= 2) v = v.substring(0, 2) + '/' + v.substring(2);
            input.value = v;
        }

        function openNewPaymentModal() {
            document.getElementById('paymentModalTitle').textContent = 'Добавление карты';
            document.getElementById('editPaymentId').value = '0';
            document.getElementById('editCardNumber').value = '';
            document.getElementById('editCardCvv').value = '';
            document.getElementById('editCardCvv').setAttribute('data-raw-value', '');
            document.getElementById('editExpiryDate').value = '';
            document.getElementById('editPaymentIsDefault').checked = false;
            var modal = new bootstrap.Modal(document.getElementById('paymentModal'));
            modal.show();
        }

        function editPayment(id) {
            var card = document.getElementById('payment-' + id);
            if (!card) { showNotification('Карта не найдена', 'danger'); return; }
            document.getElementById('paymentModalTitle').textContent = 'Изменение карты';
            document.getElementById('editPaymentId').value = id;
            var fullNumber = card.getAttribute('data-full-number') || '';
            var formatted = '';
            for (var i = 0; i < fullNumber.length; i++) {
                if (i > 0 && i % 4 === 0) formatted += ' ';
                formatted += fullNumber[i];
            }
            document.getElementById('editCardNumber').value = formatted;
            var rawCvv = card.getAttribute('data-cvv') || '';
            var maskedCvv = '';
            for (var j = 0; j < rawCvv.length; j++) { maskedCvv += '*'; }
            document.getElementById('editCardCvv').value = maskedCvv;
            document.getElementById('editCardCvv').setAttribute('data-raw-value', rawCvv);
            document.getElementById('editExpiryDate').value = card.getAttribute('data-expiry') || '';
            document.getElementById('editPaymentIsDefault').checked = card.classList.contains('default');
            var modal = new bootstrap.Modal(document.getElementById('paymentModal'));
            modal.show();
        }

        async function deletePayment(id) {
            if (!confirm('Удалить карту?')) return;
            try {
                var resp = await fetch(window.location.pathname + '?handler=DeletePayment&id=' + id, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': getToken() }
                });
                var result = await resp.json();
                if (result.success) location.reload();
                else showNotification(result.message || 'Ошибка удаления', 'danger');
            } catch(e) { showNotification('Ошибка удаления', 'danger'); }
        }

        async function savePayment() {
            var cn = document.getElementById('editCardNumber').value.replace(/\s/g, '');
            var cv = document.getElementById('editCardCvv').getAttribute('data-raw-value') || '';
            var ex = document.getElementById('editExpiryDate').value.trim();
            if (!cn || cn.length < 16) { alert('Введите полный номер карты'); return; }
            if (!cv || cv.length !== 3) { alert('Введите CVV (3 цифры)'); return; }
            if (!ex || ex.length < 5) { alert('Введите срок действия'); return; }
            var data = {
                paymentId: parseInt(document.getElementById('editPaymentId').value) || null,
                cardNumber: cn,
                cardHolder: cv,
                expiryDate: ex,
                isDefault: document.getElementById('editPaymentIsDefault').checked
            };
            try {
                var resp = await fetch(window.location.pathname + '?handler=SavePayment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                    body: JSON.stringify(data)
                });
                var result = await resp.json();
                if (result.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('paymentModal'));
                    if (modal) modal.hide();
                    location.reload();
                } else alert(result.message || 'Ошибка');
            } catch(e) { alert('Ошибка при сохранении'); }
        }

        function detectLocation() {
            if (!navigator.geolocation) { alert('Геолокация не поддерживается'); return; }
            navigator.geolocation.getCurrentPosition(function(position) {
                fetch('https://geocode-maps.yandex.ru/1.x/?apikey=4530ebd5-c3bd-4620-9f04-530dc4d2f48b&geocode=' + position.coords.longitude + ',' + position.coords.latitude + '&format=json')
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        var address = data.response.GeoObjectCollection.featureMember[0]?.GeoObject?.metaDataProperty?.GeocoderMetaData?.text;
                        if (address) {
                            openNewAddressModal();
                            setTimeout(function() {
                                var parts = address.split(', ');
                                var city = '', street = '', house = '', building = '';
                                for (var i = 0; i < parts.length; i++) {
                                    var part = parts[i];
                                    if (part.includes('Астрахань') || part.includes('Москва') || (i === 1 && !part.match(/\d/))) city = part;
                                    if (part.includes('улица') || part.includes('проспект') || part.includes('переулок')) street = part;
                                    var houseMatch = part.match(/дом\s*(\d+[а-яА-Я]?)/i);
                                    if (houseMatch) house = houseMatch[1];
                                    var buildingMatch = part.match(/корпус\s*(\d+[а-яА-Я]?)/i);
                                    if (buildingMatch) building = buildingMatch[1];
                                }
                                if (city) document.getElementById('editCity').value = city;
                                if (street) document.getElementById('editStreet').value = street;
                                if (house) document.getElementById('editHouse').value = house;
                                if (building) document.getElementById('editBuilding').value = building;
                                showNotification('Адрес определён, проверьте и сохраните', 'success');
                            }, 500);
                        } else alert('Не удалось определить адрес');
                    }).catch(function() { alert('Ошибка геокодирования'); });
            }, function(error) {
                if (error.code === 1) alert('Разрешите доступ к геолокации');
                else alert('Ошибка определения местоположения');
            });
        }

        document.getElementById('deliveryTabs').addEventListener('click', function(e) {
            e.preventDefault();
            var target = e.target.closest('a');
            if (!target) return;
            var tab = target.dataset.tab;
            if (!tab || tab === currentTab) return;
            currentTab = tab;
            var links = document.querySelectorAll('#deliveryTabs .nav-link');
            for (var i = 0; i < links.length; i++) {
                links[i].classList.remove('active');
            }
            target.classList.add('active');
            if (tab === 'delivery') {
                document.getElementById('deliverySection').style.display = 'block';
                document.getElementById('pickupSection').style.display = 'none';
            } else {
                document.getElementById('pickupSection').style.display = 'block';
                document.getElementById('deliverySection').style.display = 'none';
                setTimeout(function() { if (yandexMap) yandexMap.container.fitToViewport(); }, 200);
            }
        });

        // Скрыть подсказки промокодов при клике вне
        document.addEventListener('click', function(e) {
            var wrapper = document.querySelector('.mt-2.position-relative');
            var suggestionsDiv = document.getElementById('promoSuggestions');
            if (wrapper && !wrapper.contains(e.target)) {
                if (suggestionsDiv) suggestionsDiv.style.display = 'none';
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            updateMaxBonus();
            recalculateTotal();
            reorderAddressCards();
            reorderPaymentCards();
            initMap();
            loadUserPromoCodes();
            
            var promoInput = document.getElementById('promoCodeInput');
            if (promoInput) {
                promoInput.addEventListener('input', function() {
                    showPromoSuggestions();
                });
                promoInput.addEventListener('focus', function() {
                    if (allUserPromoCodes.length > 0 && this.value.trim().length > 0) {
                        showPromoSuggestions();
                    }
                });
            }
            
            var cardNumberInput = document.getElementById('editCardNumber');
            if (cardNumberInput) cardNumberInput.addEventListener('input', function() { maskCardNumber(this); });
            var expiryDateInput = document.getElementById('editExpiryDate');
            if (expiryDateInput) expiryDateInput.addEventListener('input', function() { maskExpiryDate(this); });
            
            var cvvInput = document.getElementById('editCardCvv');
            if (cvvInput) {
                cvvInput.setAttribute('data-raw-value', '');
                cvvInput.addEventListener('keydown', handleCvvKeyDown);
                cvvInput.addEventListener('paste', function(e) {
                    e.preventDefault();
                    var pastedText = (e.clipboardData || window.clipboardData).getData('text');
                    var digitsOnly = pastedText.replace(/\D/g, '');
                    if (digitsOnly.length > 3) digitsOnly = digitsOnly.substring(0, 3);
                    this.setAttribute('data-raw-value', digitsOnly);
                    var masked = '';
                    for (var i = 0; i < digitsOnly.length; i++) { masked += '*'; }
                    this.value = masked;
                });
            }
        });
    </script>

                </div>
                <div class="modal-footer justify-content-center border-0 pb-4">
                    <button type="button" class="btn btn-success px-4" style="border-radius:8px;" onclick="savePayment()">Сохранить</button>
                    <button type="button" class="btn btn-secondary" style="border-radius:8px;" data-bs-dismiss="modal">Отмена</button>
                </div>
            </div>

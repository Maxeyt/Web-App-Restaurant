        async function loadStatistics(period, tab) {
            try {
                const response = await fetch(`/Profile/MyProfile?handler=Statistics&period=${period}&tab=${tab}`);
                const data = await response.json();
                renderVerticalChart(data, tab);
            } catch (e) {
                console.error('Ошибка загрузки статистики:', e);
                const canvas = document.getElementById('statChart');
                if (canvas) {
                    const ctx = canvas.getContext('2d');
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    ctx.font = '14px Inter';
                    ctx.fillStyle = '#6c757d';
                    ctx.fillText('Нет данных за выбранный период', 50, 200);
                }
            }
        }

        function renderVerticalChart(data, tab) {
            const ctx = document.getElementById('statChart').getContext('2d');
            if (statChart) statChart.destroy();
            if (!data || data.length === 0) {
                ctx.clearRect(0, 0, 800, 400);
                ctx.font = '14px Inter';
                ctx.fillStyle = '#6c757d';
                ctx.fillText('Нет данных за выбранный период', 50, 200);
                return;
            }
            const labels = [];
            const chartData = [];
            const tooltipDetails = [];
            data.forEach(cat => {
                let subText = cat.subcategories.map(s => `${s.subcategoryName}: ${s.value.toFixed(1)}`).join(' · ');
                if (subText.length > 40) subText = subText.substring(0, 37) + '...';
                labels.push(`${cat.categoryName}\n${subText}`);
                let totalValue = cat.topDishes.reduce((sum, d) => sum + d.value, 0);
                chartData.push(totalValue);
                let dishesText = cat.topDishes.map(d => `${d.dishName}: ${d.value.toFixed(1)}`).join('\n');
                tooltipDetails.push(dishesText);
            });
            const labelText = tab === 'menu' ? 'Количество заказов (шт.)' : (tab === 'favorite' ? 'Количество добавлений в избранное' : 'Средний рейтинг (1-5)');
            statChart = new Chart(ctx, {
                type: 'bar',
                data: { labels: labels, datasets: [{ label: labelText, data: chartData, backgroundColor: 'rgba(43, 140, 74, 0.8)', borderColor: '#2b8c4a', borderWidth: 1, borderRadius: 6, barPercentage: 0.65, categoryPercentage: 0.8, hoverBackgroundColor: 'rgba(43, 140, 74, 0.95)' }] },
                options: {
                    responsive: true, maintainAspectRatio: true,
                    plugins: { tooltip: { callbacks: { label: function(context) { let val = context.raw; let idx = context.dataIndex; let dishes = tooltipDetails[idx] || ''; return `${labelText}: ${val.toFixed(1)}\n\nТоп-3 блюда:\n${dishes}`; } } }, legend: { position: 'top', labels: { font: { size: 11, weight: 'bold' } } } },
                    scales: { x: { ticks: { font: { size: 9 }, maxRotation: 45, minRotation: 45, callback: function(val) { let label = labels[val] || ''; return label.split('\n')[0]; } }, grid: { display: false } }, y: { title: { display: true, text: labelText, font: { size: 11, weight: 'bold' } }, ticks: { font: { size: 10 } }, grid: { display: true, color: '#e9ecef' }, beginAtZero: true } }
                }
            });
        }


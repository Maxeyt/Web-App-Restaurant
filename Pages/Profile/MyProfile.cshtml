        function updateCategoryCheckboxesUI() {
            const selectedCount = selectedCashbackIds.length;
            const countDisplay = document.getElementById('selectedCountDisplay');
            if (countDisplay) countDisplay.textContent = selectedCount;
            const container = document.getElementById('categoriesCheckboxContainer');
            if (!container) return;
            container.querySelectorAll('.category-check-card').forEach(card => {
                const catId = parseInt(card.dataset.categoryId);
                const isSelected = selectedCashbackIds.includes(catId);
                const isDisabled = selectedCount >= MAX_CATEGORIES && !isSelected;
                const chk = card.querySelector('input');
                if (chk) { chk.checked = isSelected; chk.disabled = isDisabled; }
                if (isSelected) card.classList.add('selected');
                else card.classList.remove('selected');
                card.style.opacity = isDisabled ? '0.45' : '1';
            });

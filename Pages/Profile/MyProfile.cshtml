    <script>
        let selectedCashbackIds = [];
        const MAX_CATEGORIES = 3;
        let selectedPickupId = @(Model.SelectedPickupPointId ?? 0);
        let yandexMap = null, searchPlacemark = null;
        let allMapLocations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapLocations));

        function getToken() { return document.getElementById('requestVerificationToken')?.value || document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }

        function showNotification(message, type) {
            var n = document.createElement('div');
            n.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger') + ' position-fixed top-0 end-0 m-3';
            n.style.zIndex = '9999';
            n.style.borderRadius = '12px';
            n.style.fontWeight = '600';
            n.innerHTML = '<i class="bi bi-' + (type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill') + ' me-2"></i> ' + message;
            document.body.appendChild(n);
            setTimeout(function() { n.remove(); }, 3000);
        }

        function handleCvvProfileKeyDown(e) {
            var input = e.target;
            var key = e.key;
            var currentRaw = input.getAttribute('data-raw-value') || '';
            var start = input.selectionStart;
            var end = input.selectionEnd;
            var hasSelection = (start !== end);
            if (key === 'ArrowLeft' || key === 'ArrowRight' || key === 'Tab' || key === 'Home' || key === 'End') { return; }
            if (key === 'Backspace') {
                e.preventDefault();
                var newRaw = currentRaw;
                if (hasSelection) { newRaw = currentRaw.slice(0, start) + currentRaw.slice(end); } else if (start > 0) { newRaw = currentRaw.slice(0, start - 1) + currentRaw.slice(start); }
                input.setAttribute('data-raw-value', newRaw);
                var masked = ''; for (var i = 0; i < newRaw.length; i++) { masked += '*'; }
                input.value = masked;
                var newPos = hasSelection ? start : Math.max(0, start - 1);
                input.setSelectionRange(newPos, newPos);
                return;
            }
            if (key === 'Delete') {
                e.preventDefault();
                var newRaw = currentRaw;
                if (hasSelection) { newRaw = currentRaw.slice(0, start) + currentRaw.slice(end); } else if (start < currentRaw.length) { newRaw = currentRaw.slice(0, start) + currentRaw.slice(start + 1); }
                input.setAttribute('data-raw-value', newRaw);
                var masked = ''; for (var i = 0; i < newRaw.length; i++) { masked += '*'; }
                input.value = masked;
                input.setSelectionRange(start, start);
                return;
            }
            if (key.length === 1 && /[0-9]/.test(key)) {
                e.preventDefault();
                var newRaw = currentRaw;
                if (hasSelection) { newRaw = currentRaw.slice(0, start) + key + currentRaw.slice(end); } else { newRaw = currentRaw.slice(0, start) + key + currentRaw.slice(start); }
                if (newRaw.length > 3) { newRaw = newRaw.substring(0, 3); }
                input.setAttribute('data-raw-value', newRaw);
                var masked = ''; for (var i = 0; i < newRaw.length; i++) { masked += '*'; }
                input.value = masked;
                var newPos = hasSelection ? start + 1 : start + 1;
                if (newPos > masked.length) newPos = masked.length;
                input.setSelectionRange(newPos, newPos);
                return;
            }
            if (key !== 'Tab' && key !== 'Shift' && key !== 'Control' && key !== 'Alt' && key !== 'Meta') { e.preventDefault(); }
        }

        function applyCvvMask(input, rawValue) {
            input.setAttribute('data-raw-value', rawValue || '');
            var masked = ''; var raw = rawValue || '';
            for (var i = 0; i < raw.length; i++) { masked += '*'; }
            input.value = masked;
        }


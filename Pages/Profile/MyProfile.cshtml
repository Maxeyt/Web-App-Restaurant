            let f = '';
            for(let j=0;j<v.length;j++){ if(j>0 && j%4===0) f+=' '; f+=v[j]; }
            i.value=f;
        }
        
        function maskExpiryDate(i) {
            let v = i.value.replace(/\D/g,'').substring(0,4);
            if(v.length>=2) v=v.substring(0,2)+'/'+v.substring(2);
            i.value=v;
        }
        

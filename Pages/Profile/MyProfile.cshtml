        function searchOnMap() {
            var searchText = document.getElementById('mapSearchInput')?.value;
            if (!searchText || !yandexMap) return;
            if (searchPlacemark) yandexMap.geoObjects.remove(searchPlacemark);
            ymaps.geocode(searchText + ', Астрахань', { results: 1 }).then(res => {
                const geo = res.geoObjects.get(0);
                if (geo) {
                    const coords = geo.geometry.getCoordinates();
                    const address = geo.getAddressLine();
                    searchPlacemark = new ymaps.Placemark(coords, { balloonContentBody: address }, { preset: 'islands#blueIcon' });
                    yandexMap.geoObjects.add(searchPlacemark);
                    yandexMap.setCenter(coords, 15);
                    searchPlacemark.balloon.open();
                }
            });
        }

        let debounceTimer;
        const searchInputMap = document.getElementById('mapSearchInput');
        if (searchInputMap) {
            searchInputMap.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                const q = this.value.trim();
                if (q.length < 2) { hideSuggestions(); return; }
                debounceTimer = setTimeout(() => {
                    ymaps.geocode('Астрахань, ' + q, { results: 5 }).then(res => {
                        const items = res.geoObjects.toArray();
                        const cont = document.getElementById('searchSuggestions');
                        if (!items.length) { hideSuggestions(); return; }
                        let html = '';
                        items.forEach(i => {
                            const a = i.getAddressLine();
                            html += '<div class="suggestion-item" onclick="selectSuggestion(\'' + a.replace(/'/g, "\\'") + '\')">📍 ' + a + '</div>';
                        });
                        cont.innerHTML = html;
                        cont.classList.add('show');
                    });
                }, 300);
            });
            searchInputMap.addEventListener('keydown', e => { if (e.key === 'Enter') searchOnMap(); });
            document.addEventListener('click', e => { if (!e.target.closest('.search-wrapper')) hideSuggestions(); });
        }

        function selectSuggestion(a) {
            const si = document.getElementById('mapSearchInput');
            if (si) si.value = a;
            if (yandexMap) {
                ymaps.geocode(a, { results: 1 }).then(res => {
                    const geo = res.geoObjects.get(0);
                    if (geo && yandexMap) {
                        const coords = geo.geometry.getCoordinates();
                        yandexMap.setCenter(coords, 15);
                        if (searchPlacemark) yandexMap.geoObjects.remove(searchPlacemark);
                        searchPlacemark = new ymaps.Placemark(coords, { balloonContentBody: a }, { preset: 'islands#blueIcon' });
                        yandexMap.geoObjects.add(searchPlacemark);
                        searchPlacemark.balloon.open();
                    }
                });

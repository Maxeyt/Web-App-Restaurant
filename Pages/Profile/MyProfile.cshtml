            const street = document.getElementById('editStreet').value.trim();
            const house = document.getElementById('editHouse').value.trim();
            if (!street || !house) { alert('Введите улицу и дом'); return; }
            if (!city) { alert('Введите город'); return; }
            let building = document.getElementById('editBuilding').value.trim();
            let full = street + ', д. ' + house + (building ? ', к. ' + building : '');
            const data = {
                addressId: parseInt(document.getElementById('editAddressId').value) || null,

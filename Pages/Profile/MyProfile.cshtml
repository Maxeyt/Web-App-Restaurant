        async function savePayment() {
            let cn = document.getElementById('editCardNumber').value.replace(/\s/g, '');
            let cv = document.getElementById('editCardCvv').getAttribute('data-raw-value') || '';
            let ex = document.getElementById('editExpiryDate').value.trim();
            if (!cn || cn.length < 16) { alert('Введите полный номер карты (16 цифр)'); return; }
            if (!cv || cv.length !== 3) { alert('Введите CVV (3 цифры)'); return; }
            if (!ex || ex.length < 5) { alert('Введите срок действия'); return; }
            const data = { paymentId: parseInt(document.getElementById('editPaymentId').value) || null, cardNumber: cn, cardHolder: cv, expiryDate: ex, isDefault: document.getElementById('editPaymentIsDefault').checked };
            const r = await fetch(window.location.pathname + '?handler=SavePayment', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                body: JSON.stringify(data)
            });
            const res = await r.json();
            if (res.success) { bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide(); location.reload(); }
            else alert(res.message || 'Ошибка');
        }
        
        async function deletePayment(id) {
            if (confirm('Удалить карту?')) {
                await fetch(window.location.pathname + '?handler=DeletePayment&id=' + id, { method: 'POST', headers: { 'X-CSRF-TOKEN': getToken() } });
                location.reload();
            }
        }
        
        async function toggleDefaultPayment(checkbox) {
            const id = checkbox.dataset.paymentId, checked = checkbox.checked;
            await fetch(window.location.pathname + '?handler=ToggleDefaultPayment', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                body: JSON.stringify({ paymentId: parseInt(id), isDefault: checked })
            });
            if (checked) document.querySelectorAll('.default-payment-checkbox').forEach(cb => { if (cb !== checkbox && cb.checked) cb.checked = false; });
            location.reload();
        }

        document.querySelectorAll('.copy-promo-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const code = this.getAttribute('data-code');
                if (code) {
                    navigator.clipboard.writeText(code);
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="bi bi-check-lg"></i> Скопирован!';
                    setTimeout(() => { this.innerHTML = originalText; }, 2000);
                }
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            initCashbackCategories();
            initMap();
            document.querySelectorAll('.sidebar-link[data-tab]').forEach(link => { link.addEventListener('click', (e) => { e.preventDefault(); switchTab(link.getAttribute('data-tab')); }); });
            document.querySelectorAll('#bonusSubTabs .nav-link').forEach(link => { link.addEventListener('click', (e) => { e.preventDefault(); const sub = link.getAttribute('data-bonus-subtab'); if(sub) switchBonusSubTab(sub); }); });
            document.querySelectorAll('#cashbackSubTabs .nav-link').forEach(link => { link.addEventListener('click', (e) => { e.preventDefault(); const sub = link.getAttribute('data-cashback-subtab'); if(sub) switchCashbackSubTab(sub); }); });
            document.querySelectorAll('#addressesSubTabs .nav-link').forEach(link => { link.addEventListener('click', (e) => { e.preventDefault(); const sub = link.getAttribute('data-addresses-subtab'); if(sub) switchAddressesSubTab(sub); }); });
            document.querySelectorAll('#statMainTabs .nav-link').forEach(link => { link.addEventListener('click', (e) => { e.preventDefault(); const tab = link.getAttribute('data-main-tab'); switchMainStatTab(tab); }); });
            document.querySelectorAll('#statSubTabs .nav-link').forEach(link => { link.addEventListener('click', (e) => { e.preventDefault(); const tab = link.getAttribute('data-stat-tab'); const activePeriod = document.querySelector('.period-btn.active')?.getAttribute('data-period') || 'all'; document.querySelectorAll('#statSubTabs .nav-link').forEach(l => l.classList.remove('active')); link.classList.add('active'); loadStatistics(activePeriod, tab); }); });
            document.querySelectorAll('.period-btn').forEach(btn => { btn.addEventListener('click', (e) => { e.preventDefault(); const period = btn.getAttribute('data-period'); const activeStatTab = document.querySelector('#statSubTabs .nav-link.active')?.getAttribute('data-stat-tab') || 'menu'; document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active'); if (document.getElementById('statPopularContent').style.display !== 'none') { loadStatistics(period, activeStatTab); } }); });
            const cardNumberInput = document.getElementById('editCardNumber'); if (cardNumberInput) cardNumberInput.addEventListener('input', function() { maskCardNumber(this); });
            const expiryDateInput = document.getElementById('editExpiryDate'); if (expiryDateInput) expiryDateInput.addEventListener('input', function() { maskExpiryDate(this); });
            if (document.querySelector('#addresses-pickup.active') && document.getElementById('yandexMap')) setTimeout(() => { if (yandexMap) yandexMap.container.fitToViewport(); }, 300);
            var cvvInput = document.getElementById('editCardCvv');
            if (cvvInput) { cvvInput.setAttribute('data-raw-value', ''); cvvInput.addEventListener('keydown', handleCvvProfileKeyDown); cvvInput.addEventListener('paste', function(e) { e.preventDefault(); var pastedText = (e.clipboardData || window.clipboardData).getData('text'); var digitsOnly = pastedText.replace(/\D/g, ''); if (digitsOnly.length > 3) digitsOnly = digitsOnly.substring(0, 3); applyCvvMask(this, digitsOnly); }); }
        });
    </script>
</body>
</html>
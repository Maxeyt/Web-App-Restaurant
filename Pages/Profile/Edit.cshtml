@page
@model MaxFood.Pages.Profile.EditModel
@{
    ViewData["Title"] = "Редактировать профиль";
}

<h1>Редактировать профиль</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Profile.ProfileId" />

            <div class="form-group mb-3">
                <label asp-for="Profile.FirstName" class="control-label"></label>
                <input asp-for="Profile.FirstName" class="form-control" />
                <span asp-validation-for="Profile.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Profile.LastName" class="control-label"></label>
                <input asp-for="Profile.LastName" class="form-control" />
                <span asp-validation-for="Profile.LastName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Profile.Phone" class="control-label"></label>
                <input asp-for="Profile.Phone" class="form-control" />
                <span asp-validation-for="Profile.Phone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Profile.Email" class="control-label"></label>
                <input asp-for="Profile.Email" class="form-control" />
                <span asp-validation-for="Profile.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Profile.RegistrationDate" class="control-label"></label>
                <input asp-for="Profile.RegistrationDate" class="form-control" readonly disabled />
                <small class="text-muted">Дата регистрации не редактируется</small>
            </div>

            <div class="form-group mb-3 form-check">
                <input class="form-check-input" asp-for="Profile.IsActive" />
                <label class="form-check-label" asp-for="Profile.IsActive"></label>
                <small class="text-muted d-block">Активен — пользователь может входить в систему</small>
            </div>

            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
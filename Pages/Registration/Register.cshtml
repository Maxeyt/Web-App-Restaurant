@page
@model MaxFood.Pages.Registration.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MaxFood - Регистрация</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Candara', system-ui, sans-serif;
            background: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .auth-container {
            width: 100%;
            max-width: 600px;
        }

        .auth-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            border: 1px solid #e0e0e0;
        }

        .auth-header {
            background: white;
            padding: 25px;
            text-align: center;
            border-bottom: 2px solid #f0f0f0;
            position: relative;
        }

        .auth-header h1 {
            color: #333;
            font-size: 28px;
            font-weight: 600;
            margin: 0;
        }

        .auth-header p {
            color: #666;
            margin: 10px 0 0;
            font-size: 14px;
        }

        .auth-body {
            padding: 35px;
        }

        .form-row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            flex: 1;
            margin-bottom: 0;
        }

        .form-label {
            font-weight: 500;
            color: #333;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .form-label .required {
            color: #dc3545;
        }

        .input-group-custom {
            position: relative;
        }

        .input-group-custom input {
            width: 100%;
            padding: 12px 45px 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s;
            background: white;
        }

        .input-group-custom input:focus {
            outline: none;
            border-color: #28a745;
            box-shadow: 0 0 0 3px rgba(40,167,69,0.1);
        }

        .input-group-custom input.input-error {
            border-color: #dc3545;
        }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #999;
            background: none;
            border: none;
            font-size: 18px;
        }

        .toggle-password:hover {
            color: #28a745;
        }

        .error-message {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            display: none;
        }

        .error-message.visible {
            display: block;
        }

        .checkbox-group {
            margin: 20px 0;
        }

        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            font-size: 14px;
            color: #555;
        }

        .checkbox-group input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .checkbox-group a {
            color: #28a745;
            text-decoration: underline;
        }

        .checkbox-group a:hover {
            color: #1f8b3a;
        }

        .btn-register {
            width: 100%;
            padding: 14px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-register:hover {
            background: #1f8b3a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40,167,69,0.3);
        }

        .btn-register:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .login-link {
            text-align: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
        }

        .login-link a {
            color: #28a745;
            text-decoration: none;
            font-weight: 500;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        .global-error {
            background: #fee;
            color: #dc3545;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 14px;
            display: none;
        }

        .global-error.visible {
            display: block;
        }

        .success-message {
            background: #d4edda;
            color: #155724;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 14px;
            display: none;
        }

        .success-message.visible {
            display: block;
        }

        @@media (max-width: 576px) {
            .auth-body {
                padding: 25px;
            }
            .form-row {
                flex-direction: column;
                gap: 15px;
            }
            .auth-header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <i class="bi bi-person-plus-fill fs-2" style="color: #2c5f2d;"></i>
                <h1>Регистрация</h1>
                <p>Создайте новый аккаунт</p>
            </div>
            <div class="auth-body">
                <div id="globalError" class="global-error"></div>
                <div id="successMessage" class="success-message"></div>

                <form id="registerForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Имя <span class="required">*</span></label>
                            <div class="input-group-custom"><input type="text" id="firstName" placeholder="Введите имя" maxlength="25"></div>
                            <div id="firstNameError" class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Фамилия <span class="required">*</span></label>
                            <div class="input-group-custom"><input type="text" id="lastName" placeholder="Введите фамилию" maxlength="25"></div>
                            <div id="lastNameError" class="error-message"></div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Телефон <span class="required">*</span></label>
                            <div class="input-group-custom"><input type="tel" id="phone" placeholder="+7 (999) 999-99-99" maxlength="12"></div>
                            <div id="phoneError" class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <div class="input-group-custom"><input type="email" id="email" placeholder="example@mail.ru"></div>
                            <div id="emailError" class="error-message"></div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Пароль <span class="required">*</span></label>
                            <div class="input-group-custom">
                                <input type="password" id="password" placeholder="Минимум 6 символов">
                                <button type="button" class="toggle-password" onclick="togglePassword('password')"><i class="bi bi-eye-slash"></i></button>
                            </div>
                            <div id="passwordError" class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Подтверждение пароля <span class="required">*</span></label>
                            <div class="input-group-custom">
                                <input type="password" id="confirmPassword" placeholder="Повторите пароль">
                                <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword')"><i class="bi bi-eye-slash"></i></button>
                            </div>
                            <div id="confirmPasswordError" class="error-message"></div>
                        </div>
                    </div>
                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" id="agreeTerms">
                            <span>Я принимаю условия <a href="/Terms" target="_blank">Пользовательского соглашения</a> и <a href="/Privacy" target="_blank">Политики конфиденциальности</a></span>
                        </label>
                    </div>
                    <button type="submit" class="btn-register" id="registerBtn" disabled>Зарегистрироваться</button>
                </form>
                <div class="login-link"><a href="/Authorization/Login">Уже есть аккаунт? Войти</a></div>
            </div>
        </div>
    </div>
    <script>
        var russianLettersRegex = /^[а-яА-ЯёЁ\-]+$/;
        var russianCharRegex = /^[а-яА-ЯёЁ\-]$/;

        function togglePassword(fieldId) {
            var field = document.getElementById(fieldId);
            if (!field) return;
            var icon = field.nextElementSibling ? field.nextElementSibling.querySelector('i') : null;
            if (field.type === 'password') {
                field.type = 'text';
                if (icon) {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            } else {
                field.type = 'password';
                if (icon) {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                }
            }
        }

        function capitalizeName(name) {
            if (!name) return name;
            name = name.trim();
            if (name.length === 0) return name;
            return name.charAt(0).toUpperCase() + name.slice(1).toLowerCase();
        }

        function formatPhone(input) {
            var value = input.value.replace(/\D/g, '');
            if (value.startsWith('7')) {
                value = '+' + value;
                if (value.length > 12) value = value.slice(0, 12);
                input.value = value;
            } else if (value.startsWith('8')) {
                if (value.length > 11) value = value.slice(0, 11);
                input.value = value;
            } else if (value.length > 0 && !value.startsWith('7') && !value.startsWith('8')) {
                input.value = '';
            }
        }

        function validateName(name, fieldName) {
            if (!name || name.trim() === '') {
                return { valid: false, message: 'Введите ' + fieldName };
            }
            if (!russianLettersRegex.test(name)) {
                return { valid: false, message: fieldName + ' должно содержать только русские буквы' };
            }
            if (name.length > 25) {
                return { valid: false, message: fieldName + ' не должно превышать 25 символов' };
            }
            return { valid: true, message: '' };
        }

        function validatePhone(phone) {
            if (!phone || phone.trim() === '') {
                return { valid: false, message: 'Телефон обязателен' };
            }
            var cleaned = phone.replace(/[\s\-\(\)]/g, '');
            var isValid = false;
            if (cleaned.startsWith('+7') && cleaned.length === 12) {
                isValid = /^\d{10}$/.test(cleaned.substring(2));
            } else if (cleaned.startsWith('8') && cleaned.length === 11) {
                isValid = /^\d{10}$/.test(cleaned.substring(1));
            }
            return { valid: isValid, message: isValid ? '' : 'Неверный формат номера телефона' };
        }

        function validateEmail(email) {
            if (!email || email.trim() === '') {
                return { valid: true, message: '' };
            }
            var emailPattern = /^[^\s@@]+@@([^\s@@]+\.)+[^\s@@]+$/;
            if (!emailPattern.test(email)) {
                return { valid: false, message: 'Неверный формат email' };
            }
            return { valid: true, message: '' };
        }

        function validatePasswordStrength(password) {
            if (!password || password === '') {
                return { valid: false, message: 'Введите пароль' };
            }
            if (password.length < 6) {
                return { valid: false, message: 'Пароль должен содержать минимум 6 символов' };
            }
            return { valid: true, message: '' };
        }

        function validatePasswordMatch(password, confirm) {
            if (!confirm || confirm === '') {
                return { valid: false, message: 'Подтвердите пароль' };
            }
            if (password !== confirm) {
                return { valid: false, message: 'Пароли не совпадают' };
            }
            return { valid: true, message: '' };
        }

        function setFieldError(errorElementId, validation, fieldElement) {
            var errorElement = document.getElementById(errorElementId);
            if (!errorElement) return;
            if (!validation.valid) {
                errorElement.textContent = validation.message;
                errorElement.classList.add('visible');
                if (fieldElement) fieldElement.classList.add('input-error');
            } else {
                errorElement.classList.remove('visible');
                if (fieldElement) fieldElement.classList.remove('input-error');
            }
        }

        function validateField(fieldName) {
            var firstName = document.getElementById('firstName');
            var lastName = document.getElementById('lastName');
            var phone = document.getElementById('phone');
            var email = document.getElementById('email');
            var password = document.getElementById('password');
            var confirmPassword = document.getElementById('confirmPassword');

            switch (fieldName) {
                case 'firstName':
                    var val = validateName(firstName ? firstName.value : '', 'Имя');
                    setFieldError('firstNameError', val, firstName);
                    break;
                case 'lastName':
                    var val = validateName(lastName ? lastName.value : '', 'Фамилия');
                    setFieldError('lastNameError', val, lastName);
                    break;
                case 'phone':
                    var val = validatePhone(phone ? phone.value : '');
                    setFieldError('phoneError', val, phone);
                    break;
                case 'email':
                    var val = validateEmail(email ? email.value : '');
                    setFieldError('emailError', val, email);
                    break;
                case 'password':
                    var val = validatePasswordStrength(password ? password.value : '');
                    setFieldError('passwordError', val, password);
                    if (confirmPassword) validateField('confirmPassword');
                    break;
                case 'confirmPassword':
                    var val = validatePasswordMatch(password ? password.value : '', confirmPassword ? confirmPassword.value : '');
                    setFieldError('confirmPasswordError', val, confirmPassword);
                    break;
            }
            updateButtonState();
        }

        function updateButtonState() {
            var firstName = document.getElementById('firstName');
            var lastName = document.getElementById('lastName');
            var phone = document.getElementById('phone');
            var email = document.getElementById('email');
            var password = document.getElementById('password');
            var confirmPassword = document.getElementById('confirmPassword');
            var agreeTerms = document.getElementById('agreeTerms');

            var firstNameValue = firstName ? firstName.value : '';
            var lastNameValue = lastName ? lastName.value : '';
            var phoneValue = phone ? phone.value : '';
            var emailValue = email ? email.value : '';
            var passwordValue = password ? password.value : '';
            var confirmValue = confirmPassword ? confirmPassword.value : '';
            var agreeChecked = agreeTerms ? agreeTerms.checked : false;

            var firstNameValid = validateName(firstNameValue, 'Имя').valid;
            var lastNameValid = validateName(lastNameValue, 'Фамилия').valid;
            var phoneValid = validatePhone(phoneValue).valid;
            var emailValid = validateEmail(emailValue).valid;
            var passwordValid = validatePasswordStrength(passwordValue).valid;
            var confirmValid = validatePasswordMatch(passwordValue, confirmValue).valid;

            var isValid = firstNameValid && lastNameValid && phoneValid && emailValid && passwordValid && confirmValid && agreeChecked;
            var registerBtn = document.getElementById('registerBtn');
            if (registerBtn) registerBtn.disabled = !isValid;
        }

        // ПОЛУЧАЕМ ЭЛЕМЕНТЫ
        var firstNameInput = document.getElementById('firstName');
        var lastNameInput = document.getElementById('lastName');
        var phoneInput = document.getElementById('phone');
        var emailInput = document.getElementById('email');
        var passwordInput = document.getElementById('password');
        var confirmPasswordInput = document.getElementById('confirmPassword');
        var agreeTermsCheckbox = document.getElementById('agreeTerms');

        // blur — показываем ошибки
        if (firstNameInput) firstNameInput.addEventListener('blur', function () { validateField('firstName'); });
        if (lastNameInput) lastNameInput.addEventListener('blur', function () { validateField('lastName'); });
        if (phoneInput) phoneInput.addEventListener('blur', function () { validateField('phone'); });
        if (emailInput) emailInput.addEventListener('blur', function () { validateField('email'); });
        if (passwordInput) passwordInput.addEventListener('blur', function () { validateField('password'); });
        if (confirmPasswordInput) confirmPasswordInput.addEventListener('blur', function () { validateField('confirmPassword'); });

        // input — только для маски, форматирования и обновления кнопки
        if (firstNameInput) {
            firstNameInput.addEventListener('input', function (e) {
                var cursorPos = this.selectionStart;
                var oldValue = this.value;
                var formatted = capitalizeName(this.value);
                if (oldValue !== formatted) {
                    this.value = formatted;
                    this.selectionStart = this.selectionEnd = Math.min(cursorPos, formatted.length);
                }
                updateButtonState();
            });
            firstNameInput.addEventListener('keypress', function (e) {
                var key = e.key;
                if (!russianCharRegex.test(key) && key !== '-' && key !== 'Backspace' && key !== 'Delete' && key !== 'ArrowLeft' && key !== 'ArrowRight') {
                    e.preventDefault();
                }
            });
        }

        if (lastNameInput) {
            lastNameInput.addEventListener('input', function (e) {
                var cursorPos = this.selectionStart;
                var oldValue = this.value;
                var formatted = capitalizeName(this.value);
                if (oldValue !== formatted) {
                    this.value = formatted;
                    this.selectionStart = this.selectionEnd = Math.min(cursorPos, formatted.length);
                }
                updateButtonState();
            });
            lastNameInput.addEventListener('keypress', function (e) {
                var key = e.key;
                if (!russianCharRegex.test(key) && key !== '-' && key !== 'Backspace' && key !== 'Delete' && key !== 'ArrowLeft' && key !== 'ArrowRight') {
                    e.preventDefault();
                }
            });
        }

        if (phoneInput) {
            phoneInput.addEventListener('input', function () {
                formatPhone(this);
                updateButtonState();
            });
        }

        if (emailInput) emailInput.addEventListener('input', updateButtonState);
        if (passwordInput) passwordInput.addEventListener('input', updateButtonState);
        if (confirmPasswordInput) confirmPasswordInput.addEventListener('input', updateButtonState);
        if (agreeTermsCheckbox) agreeTermsCheckbox.addEventListener('change', updateButtonState);

        // ОТПРАВКА ФОРМЫ
        var registerForm = document.getElementById('registerForm');
        if (registerForm) {
            registerForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                validateField('firstName');
                validateField('lastName');
                validateField('phone');
                validateField('email');
                validateField('password');
                validateField('confirmPassword');

                var firstName = document.getElementById('firstName');
                var lastName = document.getElementById('lastName');
                var phone = document.getElementById('phone');
                var email = document.getElementById('email');
                var password = document.getElementById('password');
                var confirmPassword = document.getElementById('confirmPassword');
                var agreeTerms = document.getElementById('agreeTerms');

                var firstNameValid = validateName(firstName ? firstName.value : '', 'Имя').valid;
                var lastNameValid = validateName(lastName ? lastName.value : '', 'Фамилия').valid;
                var phoneValid = validatePhone(phone ? phone.value : '').valid;
                var emailValid = validateEmail(email ? email.value : '').valid;
                var passwordValid = validatePasswordStrength(password ? password.value : '').valid;
                var confirmValid = validatePasswordMatch(password ? password.value : '', confirmPassword ? confirmPassword.value : '').valid;
                var agreeChecked = agreeTerms ? agreeTerms.checked : false;

                if (!firstNameValid || !lastNameValid || !phoneValid || !emailValid || !passwordValid || !confirmValid || !agreeChecked) {
                    return;
                }

                var formData = {
                    FirstName: firstName ? firstName.value : '',
                    LastName: lastName ? lastName.value : '',
                    Phone: phone ? phone.value : '',
                    Email: email ? email.value : '',
                    Password: password ? password.value : '',
                    ConfirmPassword: confirmPassword ? confirmPassword.value : '',
                    AgreeTerms: agreeChecked
                };

                try {
                    var response = await fetch('/Registration/Register?handler=Register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    });
                    var result = await response.json();
                    if (result.success) {
                        var successDiv = document.getElementById('successMessage');
                        if (successDiv) {
                            successDiv.textContent = 'Регистрация прошла успешно! Перенаправление на главную...';
                            successDiv.classList.add('visible');
                        }
                        setTimeout(function () {
                            window.location.href = result.redirectUrl;
                        }, 2000);
                    } else {
                        var errorDiv = document.getElementById('globalError');
                        if (errorDiv) {
                            errorDiv.textContent = result.message;
                            errorDiv.classList.add('visible');
                        }
                        setTimeout(function () {
                            if (errorDiv) errorDiv.classList.remove('visible');
                        }, 5000);
                    }
                } catch (error) {
                    var errorDiv = document.getElementById('globalError');
                    if (errorDiv) {
                        errorDiv.textContent = 'Ошибка соединения. Попробуйте позже.';
                        errorDiv.classList.add('visible');
                    }
                }
            });
        }
    </script>
</body>
</html>
@page
@model MaxFood.Pages.Review.IndexModel
@{
    ViewData["Title"] = "Отзывы";
    var currentUserIdStr = HttpContext.Session.GetString("UserId");
    int currentUserId = 0;
    int.TryParse(currentUserIdStr, out currentUserId);
    var role = HttpContext.Session.GetInt32("UserRole");
    bool isAdminOrManager = role == 4 || role == 3;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaxFood</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', -apple-system, sans-serif; letter-spacing: -0.2px; }
        body { background: #f5f7fa; margin: 0; padding: 20px; }
        
        .reviews-container { max-width: 1200px; margin: 0 auto; background: white; border-radius: 24px; padding: 24px; border: 1px solid #e9ecef; }
        .section-title { font-weight: 700; font-size: 1.3rem; text-align: center; margin-bottom: 20px; letter-spacing: -0.3px; }
        .nav-pills-custom { display: flex; justify-content: center; gap: 16px; margin-bottom: 24px; }
        .nav-pills-custom .nav-link { border-radius: 30px; padding: 8px 28px; font-weight: 600; font-size: 0.85rem; transition: 0.15s; }
        .nav-pills-custom .nav-link.active { background: #2b8c4a; color: white; }
        .nav-pills-custom .nav-link:not(.active) { background: #f1f3f5; color: #2c3e50; }
        .nav-pills-custom .nav-link:not(.active):hover { background: #e9ecef; }
        
        .category-row {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-bottom: 24px;
            padding-bottom: 8px;
            margin-left: 15px;
        }
        .category-btn {
            flex: 0 0 auto;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.69rem;
            font-weight: 500;
            text-decoration: none;
            transition: 0.15s;
            white-space: nowrap;
        }
        .category-btn.active { background: #2b8c4a; color: white; }
        .category-btn:not(.active) { background: #f1f3f5; color: #2c3e50; }
        .category-btn:not(.active):hover { background: #e9ecef; }
        
        .review-card { border: 1px solid #e9ecef; border-radius: 16px; padding: 16px; transition: 0.15s; background: white; display: flex; flex-direction: column; height: 100%; }
        .review-card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.05); border-color: #dee2e6; }
        .review-user { font-weight: 700; font-size: 0.85rem; color: #2c3e50; }
        .review-rating i { color: #ffc107; font-size: 0.75rem; }
        .review-dish-name { font-size: 0.75rem; font-weight: 600; color: #2b8c4a; margin: 6px 0 4px; }
        .review-comment { font-size: 0.8rem; color: #5a6874; margin-top: 8px; line-height: 1.4; }
        .review-date { font-size: 0.65rem; color: #8a99a8; }
        
        .rating-badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 500; border: 1px solid #ffc107; color: #ffc107; background: transparent; cursor: pointer; transition: 0.15s; }
        .rating-badge:hover { background: #ffc107; color: #212529; }
        .rating-zero { border-color: #adb5bd; color: #adb5bd; }
        
        .btn-review { background: #2b8c4a; color: white; border: none; border-radius: 30px; padding: 8px 24px; font-weight: 600; font-size: 0.85rem; transition: 0.15s; }
        .btn-review:hover { background: #236f3d; transform: translateY(-1px); }
        .btn-outline-custom { border: 1px solid #2b8c4a; color: #2b8c4a; background: transparent; border-radius: 30px; padding: 5px 12px; font-size: 0.7rem; transition: 0.15s; text-decoration: none; display: inline-block; }
        .btn-outline-custom:hover { background: #2b8c4a; color: white; cursor: pointer; }
        .btn-outline-danger-custom { border: 1px solid #dc3545; color: #dc3545; background: transparent; border-radius: 30px; padding: 5px 12px; font-size: 0.7rem; transition: 0.15s; text-decoration: none; display: inline-block; }
        .btn-outline-danger-custom:hover { background: #dc3545; color: white; cursor: pointer; }
        
        .review-actions { display: flex; justify-content: flex-end; gap: 8px; }
        .review-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; gap: 8px; flex-wrap: wrap; }
        .review-header-row { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px; }
        
        .category-tree { margin-bottom: 16px; padding-left: 20px; border-left: 2px solid #e9ecef; }
        .category-tree-item { padding: 4px 0; }
        .category-tree-icon { margin-right: 8px; font-size: 1rem; }
        
        .modal-content-custom { border-radius: 24px; border: none; }
        .modal-header-custom { background: #2b8c4a; color: white; border-radius: 24px 24px 0 0; padding: 16px; }
        
        .suggestions-box { position: absolute; background: white; border: 1px solid #dee2e6; border-radius: 12px; max-height: 200px; overflow-y: auto; z-index: 1000; width: calc(100% - 2px); }
        .suggestion-item { padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0; transition: 0.1s; }
        .suggestion-item:hover { background: #e8f5e9; }
        
        @@media (max-width: 768px) { 
            .reviews-container { padding: 16px; } 
            .category-btn { font-size: 0.65rem; padding: 4px 10px; } 
            .category-tree { padding-left: 8px; } 
            .category-row { margin-left: 5px; }
        }
    </style>
</head>
<body>
    <div class="reviews-container">
        <div class="section-title"><i class="bi bi-star-fill me-2" style="color: #ffc107;"></i> Отзывы</div>
        
        <div class="nav-pills-custom">
            <a href="/Review/Index" class="nav-link @(Model.ActiveTab == "dish" ? "active" : "")"><i class="bi bi-egg-fried me-1"></i> О блюдах</a>
            <a href="/Review/Index?type=restaurant" class="nav-link @(Model.ActiveTab == "restaurant" ? "active" : "")"><i class="bi bi-building me-1"></i> О заведении</a>
        </div>

        @if (Model.ActiveTab == "dish")
        {
            <div class="text-center mb-4"><button class="btn-review" onclick="openDishReviewModal()"><i class="bi bi-plus-lg me-1"></i> Оставить отзыв о блюде</button></div>
            
            <div class="category-row">
                <a href="/Review/Index" class="category-btn @(Model.SelectedCategoryId == null && Model.SelectedDish == null ? "active" : "")">Все</a>
                @foreach (var cat in Model.Categories)
                {
                    <a href="/Review/Index?categoryId=@cat.CategoryId" class="category-btn @(Model.SelectedCategoryId == cat.CategoryId ? "active" : "")">@cat.Icon @cat.CategoryName</a>
                }
            </div>

            @if (!Model.ReviewGroups.Any())
            {
                <div class="text-center py-5"><i class="bi bi-chat-square-text fs-1 text-muted"></i><p class="mt-2">Пока нет отзывов о блюдах</p></div>
            }
            else
            {
                @foreach (var categoryGroup in Model.ReviewGroups)
                {
                    <div class="mt-4">
                        <div class="d-flex align-items-center gap-3 mb-3 pb-2 border-bottom">
                            <h3 class="fw-bold mb-0" style="font-size: 1.2rem;">@categoryGroup.Icon @categoryGroup.CategoryName</h3>
                            <div class="rating-badge @(categoryGroup.AverageRating > 0 ? "" : "rating-zero")" onclick="location.href='/Review/Index?categoryId=@categoryGroup.CategoryId'">⭐ @categoryGroup.AverageRating.ToString("0.0")</div>
                        </div>
                        
                        @foreach (var subGroup in categoryGroup.SubcategoryGroups)
                        {
                            @if (subGroup.SubcategoryName != "Без подкатегории")
                            {
                                <div class="category-tree">
                                    <div class="category-tree-item">
                                        <i class="bi bi-folder2-open category-tree-icon"></i>
                                        <strong>@subGroup.SubcategoryName</strong>
                                        <span class="rating-badge @(subGroup.AverageRating > 0 ? "" : "rating-zero") ms-2" style="padding: 2px 8px;">⭐ @subGroup.AverageRating.ToString("0.0")</span>
                                    </div>
                                </div>
                            }
                            
                            @foreach (var dishGroup in subGroup.Reviews.GroupBy(r => r.DishId))
                            {
                                var firstDish = dishGroup.First();
                                var dishRating = dishGroup.Average(r => r.Rating);
                                
                                <div class="category-tree" style="margin-left: 20px;">
                                    <div class="category-tree-item">
                                        <i class="bi bi-egg-fried category-tree-icon"></i>
                                        <strong>@(firstDish.Dish?.DishName ?? "Блюдо")</strong>
                                        <span class="rating-badge @(dishRating > 0 ? "" : "rating-zero") ms-2" style="padding: 2px 8px;">⭐ @dishRating.ToString("0.0")</span>
                                    </div>
                                </div>
                                
                                <div class="row g-3 mt-1 mb-4">
                                    @foreach (var item in dishGroup)
                                    {
                                        var userName = item.AppUser?.UserProfile != null ? $"{item.AppUser.UserProfile.FirstName} {item.AppUser.UserProfile.LastName}" : "Пользователь";
                                        var canModerate = isAdminOrManager || currentUserId == item.AppUserId;
                                        var isOwnReview = currentUserId == item.AppUserId;
                                        
                                        <div class="col-md-4">
                                            <div class="review-card">
                                                <div class="review-header-row">
                                                    <div>
                                                        <div class="review-user"><i class="bi bi-person-circle me-1"></i> @userName</div>
                                                        <div class="review-rating mt-1">@for (int i = 1; i <= 5; i++){<i class="bi @(i <= item.Rating ? "bi-star-fill" : "bi-star")"></i>}</div>
                                                    </div>
                                                    <div class="review-date">@item.ReviewDate.ToString("dd.MM.yyyy")</div>
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.Comment)) { <div class="review-comment">@item.Comment</div> }
                                                
                                                <div class="review-footer">
                                                    @if (!isOwnReview)
                                                    {
                                                        <a href="/Support/Index?userId=@item.AppUserId" class="btn-outline-custom"><i class="bi bi-chat-left-dots"></i> Написать</a>
                                                    }
                                                    else
                                                    {
                                                        <div></div>
                                                    }
                                                    
                                                    @if (canModerate)
                                                    {
                                                        <div class="review-actions">
                                                            <button class="btn-outline-custom" onclick='editDishReview(@item.ReviewDishId, @item.DishId, "@item.Dish?.DishName?.Replace("\"", "\\\"")", @item.Rating, `@item.Comment?.Replace("`", "\\`")`?.replace(/\n/g, "\\n"))'><i class="bi bi-pencil"></i> Изменить</button>
                                                            <button class="btn-outline-danger-custom" onclick="deleteDishReview(@item.ReviewDishId)"><i class="bi bi-trash"></i> Удалить</button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            }
        }
        else
        {
            <div class="text-center mb-4"><button class="btn-review" onclick="openRestaurantReviewModal()"><i class="bi bi-plus-lg me-1"></i> Оставить отзыв о заведении</button></div>
            
            @if (!Model.ReviewRestaurants.Any())
            {
                <div class="text-center py-5"><i class="bi bi-chat-square-text fs-1 text-muted"></i><p class="mt-2">Пока нет отзывов о заведении</p></div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model.ReviewRestaurants)
                    {
                        var userName = item.AppUser?.UserProfile != null ? $"{item.AppUser.UserProfile.FirstName} {item.AppUser.UserProfile.LastName}" : "Пользователь";
                        var canModerate = isAdminOrManager || currentUserId == item.AppUserId;
                        var isOwnReview = currentUserId == item.AppUserId;
                        
                        <div class="col-md-6">
                            <div class="review-card">
                                <div class="review-header-row">
                                    <div>
                                        <div class="review-user"><i class="bi bi-person-circle me-1"></i> @userName</div>
                                        <div class="review-rating mt-1">@for (int i = 1; i <= 5; i++){<i class="bi @(i <= item.Rating ? "bi-star-fill" : "bi-star")"></i>}</div>
                                    </div>
                                    <div class="review-date">@item.ReviewDate.ToString("dd.MM.yyyy")</div>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Comment)) { <div class="review-comment">@item.Comment</div> }
                                
                                <div class="review-footer">
                                    @if (!isOwnReview)
                                    {
                                        <a href="/Support/Index?userId=@item.AppUserId" class="btn-outline-custom"><i class="bi bi-chat-left-dots"></i> Написать</a>
                                    }
                                    else
                                    {
                                        <div></div>
                                    }
                                    
                                    @if (canModerate)
                                    {
                                        <div class="review-actions">
                                            <button class="btn-outline-custom" onclick='editRestaurantReview(@item.ReviewRestaurantId, @item.Rating, `@item.Comment?.Replace("`", "\\`")`?.replace(/\n/g, "\\n"))'><i class="bi bi-pencil"></i> Изменить</button>
                                            <button class="btn-outline-danger-custom" onclick="deleteRestaurantReview(@item.ReviewRestaurantId)"><i class="bi bi-trash"></i> Удалить</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Модальное окно отзыва о блюде -->
    <div class="modal fade" id="dishReviewModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-content-custom">
                <div class="modal-header modal-header-custom">
                    <h5 class="modal-title text-center w-100" id="dishReviewModalTitle">Отзыв о блюде</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="editDishReviewId" value="0">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Блюдо</label>
                        <input type="text" id="dishSearchInput" class="form-control" placeholder="Введите название блюда..." autocomplete="off">
                        <div id="dishSuggestions" class="suggestions-box" style="display:none;"></div>
                        <input type="hidden" id="selectedDishId" value="">
                    </div>
                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold d-block">Оценка</label>
                        <div id="dishStars" class="fs-2">
                            <i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i>
                        </div>
                        <input type="hidden" id="dishRating" value="0">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Комментарий</label>
                        <textarea id="dishComment" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-success px-4" style="border-radius:30px;" onclick="submitDishReview()">Отправить</button>
                    <button class="btn btn-secondary" style="border-radius:30px;" data-bs-dismiss="modal">Отмена</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Модальное окно отзыва о заведении -->
    <div class="modal fade" id="restaurantReviewModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-content-custom">
                <div class="modal-header modal-header-custom">
                    <h5 class="modal-title text-center w-100" id="restaurantReviewModalTitle">Отзыв о заведении</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="editRestaurantReviewId" value="0">
                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold d-block">Оценка</label>
                        <div id="restaurantStars" class="fs-2">
                            <i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i>
                        </div>
                        <input type="hidden" id="restaurantRating" value="0">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Комментарий</label>
                        <textarea id="restaurantComment" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-success px-4" style="border-radius:30px;" onclick="submitRestaurantReview()">Отправить</button>
                    <button class="btn btn-secondary" style="border-radius:30px;" data-bs-dismiss="modal">Отмена</button>
                </div>
            </div>
        </div>
    </div>

    <form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
        
        function initStars(containerId, inputId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const stars = container.querySelectorAll('i');
            const update = (v) => {
                stars.forEach((s, i) => {
                    s.className = i < v ? 'bi bi-star-fill' : 'bi bi-star';
                });
            };
            stars.forEach((s, i) => {
                s.onclick = () => {
                    document.getElementById(inputId).value = i + 1;
                    update(i + 1);
                };
                s.onmouseenter = () => update(i + 1);
            });
            container.onmouseleave = () => update(document.getElementById(inputId).value);
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            initStars('dishStars', 'dishRating');
            initStars('restaurantStars', 'restaurantRating');
            
            // Инициализация поиска с подсказками
            const dishSearchInput = document.getElementById('dishSearchInput');
            const dishSuggestions = document.getElementById('dishSuggestions');
            let searchTimeout;
            
            if (dishSearchInput) {
                dishSearchInput.addEventListener('input', function() {
                    const query = this.value.trim();
                    if (query.length < 2) {
                        dishSuggestions.style.display = 'none';
                        return;
                    }
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(async () => {
                        try {
                            const response = await fetch(`/Review/Index?handler=SearchDishesForReview&term=${encodeURIComponent(query)}`);
                            const data = await response.json();
                            if (!data || data.length === 0) {
                                dishSuggestions.innerHTML = '<div class="p-2 text-muted">Ничего не найдено</div>';
                                dishSuggestions.style.display = 'block';
                                return;
                            }
                            let html = '';
                            data.forEach(d => {
                                html += `<div class="suggestion-item" data-id="${d.dishId}" data-name="${d.dishName.replace(/'/g, "\\'")}" onclick="selectDish(${d.dishId}, '${d.dishName.replace(/'/g, "\\'")}')">
                                    <i class="bi bi-search me-2"></i> ${d.dishName}
                                </div>`;
                            });
                            dishSuggestions.innerHTML = html;
                            dishSuggestions.style.display = 'block';
                        } catch(e) {
                            console.error('Ошибка поиска:', e);
                        }
                    }, 300);
                });
                
                document.addEventListener('click', function(e) {
                    if (!dishSearchInput.contains(e.target) && !dishSuggestions.contains(e.target)) {
                        dishSuggestions.style.display = 'none';
                    }
                });
            }
        });
        
        function selectDish(id, name) {
            document.getElementById('selectedDishId').value = id;
            document.getElementById('dishSearchInput').value = name;
            document.getElementById('dishSuggestions').style.display = 'none';
        }
        
        async function openDishReviewModal() {
            try {
                const resp = await fetch('/Cart/MyCart?handler=Count');
                if (!resp.ok) { alert('Войдите, чтобы оставить отзыв'); return; }
                resetDishModal();
                new bootstrap.Modal(document.getElementById('dishReviewModal')).show();
            } catch(e) { alert('Ошибка'); }
        }
        
        function resetDishModal() {
            document.getElementById('editDishReviewId').value = '0';
            document.getElementById('dishSearchInput').value = '';
            document.getElementById('selectedDishId').value = '';
            document.getElementById('dishRating').value = 0;
            document.getElementById('dishComment').value = '';
            const stars = document.querySelectorAll('#dishStars i');
            stars.forEach((s, i) => { s.className = 'bi bi-star'; });
        }
        
        async function submitDishReview() {
            const rid = document.getElementById('editDishReviewId').value;
            const did = document.getElementById('selectedDishId').value;
            const rating = document.getElementById('dishRating').value;
            const comment = document.getElementById('dishComment').value;
            if (!did || rating == 0) { alert('Выберите блюдо и поставьте оценку'); return; }
            const isEdit = rid && rid !== '0';
            const url = isEdit ? '/Review/Index?handler=UpdateDishReview' : '/Review/Index?handler=CreateDishReview';
            const body = isEdit ? JSON.stringify({ reviewDishId: parseInt(rid), rating: parseInt(rating), comment: comment }) : JSON.stringify({ dishId: parseInt(did), rating: parseInt(rating), comment: comment });
            const resp = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() }, body });
            const result = await resp.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('dishReviewModal')).hide();
                location.reload();
            } else alert(result.message || 'Ошибка');
        }
        
        function editDishReview(rid, did, dn, r, c) {
            resetDishModal();
            document.getElementById('editDishReviewId').value = rid;
            document.getElementById('selectedDishId').value = did;
            document.getElementById('dishSearchInput').value = dn;
            document.getElementById('dishRating').value = r;
            document.getElementById('dishComment').value = (c || '').replace(/\\n/g, '\n');
            const stars = document.querySelectorAll('#dishStars i');
            stars.forEach((s, i) => {
                s.className = i < r ? 'bi bi-star-fill' : 'bi bi-star';
            });
            new bootstrap.Modal(document.getElementById('dishReviewModal')).show();
        }
        
        async function deleteDishReview(rid) {
            if (!confirm('Удалить отзыв?')) return;
            const resp = await fetch(`/Review/Index?handler=DeleteDishReview&id=${rid}`, { method: 'POST', headers: { 'X-CSRF-TOKEN': getToken() } });
            const result = await resp.json();
            if (result.success) location.reload();
            else alert('Ошибка');
        }
        
        async function openRestaurantReviewModal() {
            try {
                const resp = await fetch('/Cart/MyCart?handler=Count');
                if (!resp.ok) { alert('Войдите, чтобы оставить отзыв'); return; }
                resetRestaurantModal();
                new bootstrap.Modal(document.getElementById('restaurantReviewModal')).show();
            } catch(e) { alert('Ошибка'); }
        }
        
        function resetRestaurantModal() {
            document.getElementById('editRestaurantReviewId').value = '0';
            document.getElementById('restaurantRating').value = 0;
            document.getElementById('restaurantComment').value = '';
            const stars = document.querySelectorAll('#restaurantStars i');
            stars.forEach((s, i) => { s.className = 'bi bi-star'; });
        }
        
        function editRestaurantReview(rid, r, c) {
            resetRestaurantModal();
            document.getElementById('editRestaurantReviewId').value = rid;
            document.getElementById('restaurantRating').value = r;
            document.getElementById('restaurantComment').value = (c || '').replace(/\\n/g, '\n');
            const stars = document.querySelectorAll('#restaurantStars i');
            stars.forEach((s, i) => {
                s.className = i < r ? 'bi bi-star-fill' : 'bi bi-star';
            });
            new bootstrap.Modal(document.getElementById('restaurantReviewModal')).show();
        }
        
        async function submitRestaurantReview() {
            const rid = document.getElementById('editRestaurantReviewId').value;
            const rating = document.getElementById('restaurantRating').value;
            const comment = document.getElementById('restaurantComment').value;
            if (rating == 0) { alert('Поставьте оценку'); return; }
            const isEdit = rid && rid !== '0';
            const url = isEdit ? '/Review/Index?handler=UpdateRestaurantReview' : '/Review/Index?handler=CreateRestaurantReview';
            const body = isEdit ? JSON.stringify({ reviewRestaurantId: parseInt(rid), rating: parseInt(rating), comment: comment }) : JSON.stringify({ rating: parseInt(rating), comment: comment });
            const resp = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() }, body });
            const result = await resp.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('restaurantReviewModal')).hide();
                location.reload();
            } else alert(result.message || 'Ошибка');
        }
        
        async function deleteRestaurantReview(rid) {
            if (!confirm('Удалить отзыв?')) return;
            const resp = await fetch(`/Review/Index?handler=DeleteRestaurantReview&id=${rid}`, { method: 'POST', headers: { 'X-CSRF-TOKEN': getToken() } });
            const result = await resp.json();
            if (result.success) location.reload();
            else alert('Ошибка');
        }
    </script>
</body>
</html>
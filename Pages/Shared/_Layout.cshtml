﻿
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#28a745" />
    <title>@ViewData["Title"] - MaxFood</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ========== ГЛОБАЛЬНЫЕ НАСТРОЙКИ ========== */
        * {
            font-family: 'Montserrat', 'Segoe UI', 'Helvetica Neue', sans-serif !important;
            letter-spacing: -0.02em;
        }

        html {
            height: 100%;
        }

        body {
            background: #f5f7fa;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        main {
            flex: 1;
        }

        /* ========== НАВИГАЦИЯ ========== */
        .navbar {
            background: white !important;
            border-bottom: 1px solid #e5e7eb;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            min-height: auto !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }

        .navbar-brand {
            padding: 0;
            margin: 0;
            line-height: 1;
            display: flex;
            align-items: center;
        }

            .navbar-brand img {
                display: block;
                margin: 0;
                padding: 0;
                height: 70px;
                width: auto;
                transition: height 0.2s ease;
            }

        .navbar-toggler {
            border: none;
            padding: 8px 12px;
            border-radius: 12px;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 2px rgba(40,167,69,0.25);
                outline: none;
            }

        .navbar-nav .nav-link {
            font-size: 0.85rem;
            font-weight: 600;
            color: #374151 !important;
            border-radius: 12px;
            transition: all 0.2s;
            padding: 0.5rem 0.75rem !important;
            white-space: nowrap;
        }

            .navbar-nav .nav-link:hover {
                background: #e8f5e9;
                color: #28a745 !important;
            }

            .navbar-nav .nav-link.text-danger:hover {
                background: #fee2e2;
                color: #dc3545 !important;
            }

            .navbar-nav .nav-link.active {
                color: #28a745 !important;
                background: transparent;
                border-bottom: 2px solid #28a745;
            }

        /* Бейджики */
        .cart-badge, .notification-badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background: #dc3545;
            color: white;
            border-radius: 30px;
            font-size: 0.65rem;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 5px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.2);
        }

        .position-relative {
            position: relative;
        }

        .navbar-spacer {
            height: 70px;
        }

        /* ========== КАРТОЧКИ ========== */
        .card, .modal-content {
            background: white;
            border-radius: 16px !important;
            border: 1px solid #e5e7eb;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            transition: all 0.2s;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            }

        /* ========== КНОПКИ ========== */
        .btn {
            border-radius: 12px !important;
            padding: 8px 20px;
            font-weight: 600;
            transition: all 0.2s;
            cursor: pointer;
        }

        .btn-success {
            background: #28a745;
            border: none;
        }

            .btn-success:hover {
                background: #1f8b3a;
                transform: translateY(-1px);
            }

        .btn-outline-success {
            color: #28a745;
            border-color: #28a745;
        }

            .btn-outline-success:hover {
                background: #28a745;
                color: white;
            }

        .btn-danger {
            background: #dc3545;
            border: none;
        }

            .btn-danger:hover {
                background: #b91c2c;
            }

        .btn-outline-danger {
            color: #dc3545;
            border-color: #dc3545;
        }

            .btn-outline-danger:hover {
                background: #dc3545;
                color: white;
            }

        /* ========== ФОРМЫ ========== */
        .form-control, .form-select {
            border-radius: 12px;
            border: 1px solid #d1d5db;
            padding: 10px 14px;
            font-size: 16px;
            transition: all 0.2s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #28a745;
                box-shadow: 0 0 0 2px rgba(40,167,69,0.1);
                outline: none;
            }

        .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 4px;
            color: #4b5563;
        }

        /* ========== ЦВЕТА ========== */
        .text-primary, .text-success {
            color: #28a745 !important;
        }

        .bg-primary, .bg-success {
            background-color: #28a745 !important;
        }

        .border-primary, .border-success {
            border-color: #28a745 !important;
        }

        /* ========== РЕЙТИНГ ========== */
        .rating-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 600;
            border: 1px solid #ffc107;
            background: transparent;
            color: #ffc107;
        }

            .rating-badge:hover {
                background: #ffc107;
                color: #212529;
            }

        .rating-zero {
            border-color: #9ca3af;
            color: #9ca3af;
        }

        /* ========== МОДАЛЬНОЕ ОКНО ========== */
        .modal-header {
            background: #28a745 !important;
            border-radius: 16px 16px 0 0;
            padding: 1rem;
        }

            .modal-header .modal-title {
                font-weight: 700;
                color: white;
            }

        .modal-footer {
            border-top: 1px solid #e5e7eb;
            border-radius: 0 0 16px 16px;
        }

        /* ========== ФУТЕР ========== */
        .footer {
            background: #1a2a1c;
            color: #d4e6d1;
            border-top: none;
            padding: 2.5rem 0 1.5rem;
            margin-top: auto;
            width: 100%;
        }

        .footer-heading {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #7aa57a;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .footer-item {
            font-size: 0.85rem;
            color: #7aa57a;
            margin-bottom: 0.75rem;
        }

            .footer-item i {
                color: #28a745;
                margin-right: 8px;
                width: 20px;
            }

        .footer a {
            color: #7aa57a !important;
            text-decoration: underline !important;
            text-underline-offset: 3px;
            transition: color 0.2s;
        }

            .footer a:hover {
                color: #28a745 !important;
                text-decoration: underline !important;
            }

            .footer a i {
                color: #28a745;
                text-decoration: none !important;
            }

            .footer a:hover i {
                color: #3dd15d;
            }

        .footer-copyright {
            text-align: center;
            color: #7aa57a;
            font-size: 0.7rem;
            margin-top: 2rem;
            padding-top: 1rem;
            border-top: 1px solid #2c3e2e;
        }

        .footer-divider {
            width: 40px;
            height: 2px;
            background: #28a745;
            margin: 1rem auto 1rem 0;
        }

        .footer-divider-center {
            width: 40px;
            height: 2px;
            background: #28a745;
            margin: 1rem auto;
        }

        /* ========== АНИМАЦИИ ========== */
        @@keyframes spin {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        .bi-arrow-repeat.spin {
            animation: spin 0.5s linear infinite;
        }

        /* ========== МОБИЛЬНАЯ АДАПТАЦИЯ ========== */
        @@media (max-width: 768px) {
            /* Логотип */
            .navbar-brand img

        {
            height: 45px;
        }

        .navbar-spacer {
            height: 56px;
        }

        /* Навбар - вертикальное меню */
        .navbar-collapse {
            max-height: calc(100vh - 56px);
            overflow-y: auto;
            padding: 12px 0;
        }

        .navbar-nav .nav-link {
            font-size: 1rem;
            padding: 12px 16px !important;
            white-space: normal;
            margin: 2px 0;
        }

        /* Бейджики на мобилке */
        .cart-badge, .notification-badge {
            top: 8px;
            right: 8px;
            min-width: 20px;
            height: 20px;
            font-size: 0.7rem;
        }

        /* Кнопки на всю ширину */
        .btn {
            padding: 12px 20px;
            width: 100%;
            margin-bottom: 8px;
        }

        .btn-group .btn {
            width: auto;
        }

        /* Отключаем ховер-эффекты на тач-устройствах */
        .card:hover {
            transform: none;
        }

        .btn-success:hover, .btn-outline-success:hover {
            transform: none;
        }

        /* Отступы контейнера */
        .container {
            padding-left: 12px;
            padding-right: 12px;
        }

        /* Футер на мобилке */
        .footer .text-md-end,
        .footer .text-md-center,
        .footer .text-start {
            text-align: center !important;
        }

        .footer .text-start {
            margin-bottom: 1.5rem;
        }

        .footer-divider,
        .footer-divider-center {
            margin-left: auto;
            margin-right: auto;
        }

        /* Карточки на мобилке */
        .card {
            margin-bottom: 12px;
        }

        /* Модальные окна на мобилке */
        .modal-dialog {
            margin: 16px;
        }

        .modal-content {
            border-radius: 20px !important;
        }

        /* Формы на мобилке */
        .form-control, .form-select {
            font-size: 16px;
        }

        /* Заголовки */
        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        }

        /* Дополнительная адаптация для очень маленьких экранов (iPhone SE, 375px) */
        @@media (max-width: 480px) {
            .navbar-brand img

        {
            height: 38px;
        }

        .navbar-nav .nav-link {
            font-size: 0.95rem;
            padding: 10px 14px !important;
        }

        .btn {
            padding: 10px 16px;
        }

        .footer-heading {
            font-size: 0.7rem;
        }

        .footer-item {
            font-size: 0.75rem;
        }

        .cart-badge, .notification-badge {
            min-width: 18px;
            height: 18px;
            font-size: 0.65rem;
            top: 6px;
            right: 6px;
        }

        }

        /* Планшеты (768px - 1024px) */
        @@media (min-width: 769px) and (max-width: 1024px) {
            .container

        {
            max-width: 960px;
            padding-left: 20px;
            padding-right: 20px;
        }

        .navbar-nav .nav-link {
            font-size: 0.8rem;
            padding: 0.5rem 0.6rem !important;
        }

        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light fixed-top">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <img src="~/Resources/MaxFoodLogo.png" alt="MaxFood" style="height: 70px; width: auto; display: block;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-label="Открыть меню" aria-expanded="false" aria-controls="navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house-door-fill me-2"></i> Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Menu/Index">
                                <i class="bi bi-book-fill me-2"></i> Меню
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Promotion/Index">
                                <i class="bi bi-tags-fill me-2"></i> Акции
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/FavoriteDish/MyFavoriteDish">
                                <i class="bi bi-heart-fill me-2"></i> Избранное
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Review/Index">
                                <i class="bi bi-star-fill me-2"></i> Отзывы
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Support/Index">
                                <i class="bi bi-chat-left-dots-fill me-2"></i> Сообщения
                            </a>
                        </li>
                        <li class="nav-item position-relative">
                            <a class="nav-link" href="/Notification/MyNotification">
                                <i class="bi bi-bell-fill me-2"></i> Уведомления
                                <span id="notificationBadge" class="notification-badge" style="display: none;">0</span>
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item position-relative">
                            <a class="nav-link" href="/Cart/MyCart" id="cartLink">
                                <i class="bi bi-cart-fill me-2"></i> Корзина
                                <span id="cartBadge" class="cart-badge" style="display: none;">0</span>
                            </a>
                        </li>
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserId")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Profile/MyProfile">
                                    <i class="bi bi-person-circle me-2"></i> Профиль
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-page="/Authorization/Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Выйти
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Authorization/Login">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Войти
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Registration/Register">
                                    <i class="bi bi-person-plus-fill me-2"></i> Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="navbar-spacer"></div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ФУТЕР -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 text-start mb-4 mb-md-0">
                    <div class="footer-heading">Основная информация</div>
                    <div class="footer-divider"></div>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-page="/FAQ/Index">
                                <i class="bi bi-question-circle me-2"></i>Часто задаваемые вопросы
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-page="/PointPickup/Index">
                                <i class="bi bi-shop me-2"></i>Точки самовывоза
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-page="/About/Index">
                                <i class="bi bi-info-circle me-2"></i>О нас
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <div class="footer-heading">Контакты</div>
                    <div class="footer-divider-center"></div>
                    <div class="footer-item">
                        <i class="bi bi-headset"></i> <a asp-page="/Support/Index">Поддержка</a>
                    </div>
                    <div class="footer-item">
                        <i class="bi bi-envelope"></i> MaxFood@mail.ru
                    </div>
                    <div class="footer-item">
                        <i class="bi bi-telephone-fill"></i> +7 (999) 888-85-12
                    </div>
                </div>

                <div class="col-md-4 text-start text-md-end">
                    <div class="footer-heading">Правовая информация</div>
                    <div class="footer-divider" style="margin-left: auto; margin-right: 0;"></div>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-page="/Terms">
                                <i class="bi bi-file-text me-2"></i>Пользовательское соглашение
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-page="/Privacy">
                                <i class="bi bi-shield-lock me-2"></i>Политика конфиденциальности
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-copyright">
                © 2025-2026 Максимум еды - доставка еды
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        window.getAntiForgeryToken = function() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        window.isUserAuthenticated = async function() {
            try {
                return (await fetch('/Cart/MyCart?handler=Count')).ok;
            } catch {
                return false;
            }
        };

        window.loadCartCount = async function() {
            try {
                const r = await fetch('/Cart/MyCart?handler=Count');
                if (!r.ok) throw new Error('');
                const d = await r.json();
                const b = document.getElementById('cartBadge');
                if (b) {
                    const c = d.count || 0;
                    b.textContent = c;
                    b.style.display = c > 0 ? 'flex' : 'none';
                }
            } catch (e) {
                console.log('Ошибка корзины:', e);
            }
        };

        window.loadNotificationCount = async function() {
            try {
                const r = await fetch('/Notification/MyNotification?handler=Count');
                if (!r.ok) return;
                const d = await r.json();
                const b = document.getElementById('notificationBadge');
                if (b) {
                    const c = d.count || 0;
                    b.textContent = c;
                    b.style.display = c > 0 ? 'flex' : 'none';
                }
            } catch (e) {
                console.log('Ошибка уведомлений:', e);
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            if (typeof window.loadCartCount === 'function') window.loadCartCount();
            if (typeof window.loadNotificationCount === 'function') window.loadNotificationCount();

            // Закрываем меню после клика по ссылке на мобилке
            const navbarCollapse = document.getElementById('navbarNav');
            const navLinks = document.querySelectorAll('.navbar-nav .nav-link');

            if (navbarCollapse && window.innerWidth <= 768) {
                navLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        const bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
                        if (bsCollapse) bsCollapse.hide();
                    });
                });
            }
        });

        document.getElementById('cartLink')?.addEventListener('click', async function(e) {
            if (!await window.isUserAuthenticated()) {
                e.preventDefault();
                window.showAuthModal();
            }
        });

        window.showAuthModal = function() {
            if (document.getElementById('authModal')) return;

            var h = '<div class="modal fade" id="authModal" tabindex="-1">' +
                    '<div class="modal-dialog modal-dialog-centered">' +
                    '<div class="modal-content">' +
                    '<div class="modal-header bg-warning">' +
                    '<h5 class="modal-title fw-bold">Требуется авторизация</h5>' +
                    '<button type="button" class="btn-close" data-bs-dismiss="modal"></button>' +
                    '</div>' +
                    '<div class="modal-body text-center py-4">' +
                    '<p class="mb-3">Чтобы выполнить это действие, пожалуйста, <strong>войдите</strong> или <strong>зарегистрируйтесь</strong>.</p>' +
                    '<div class="d-flex flex-column flex-sm-row gap-3 justify-content-center mt-4">' +
                    '<a href="/Authorization/Login" class="btn btn-success px-4">Войти</a>' +
                    '<a href="/Registration/Register" class="btn btn-outline-success px-4">Регистрация</a>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';

            document.body.insertAdjacentHTML('beforeend', h);
            var m = new bootstrap.Modal(document.getElementById('authModal'));
            m.show();
            document.getElementById('authModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
        };

        window.showNotification = function(message, type) {
            const n = document.createElement('div');
            n.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger') + ' position-fixed top-0 end-0 m-3';
            n.style.zIndex = '9999';
            n.style.borderRadius = '12px';
            n.style.fontWeight = '600';
            n.style.maxWidth = 'calc(100% - 24px)';
            n.style.fontSize = window.innerWidth <= 768 ? '0.875rem' : '1rem';
            n.innerHTML = '<i class="bi bi-' + (type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill') + ' me-2"></i> ' + message;
            document.body.appendChild(n);
            setTimeout(function() { n.remove(); }, 3000);
        };

        window.quickAddToCart = async function(variantId, dishName) {
            if (!variantId) return;
            if (!await window.isUserAuthenticated()) {
                window.showAuthModal();
                return;
            }

            fetch('/Cart/MyCart?handler=AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': window.getAntiForgeryToken()
                },
                body: JSON.stringify({ dishVariantId: variantId, quantity: 1 })
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    if (window.loadCartCount) window.loadCartCount();
                    window.showNotification('✅ ' + dishName + ' добавлено!', 'success');
                } else if (d.message === 'Необходимо авторизоваться') {
                    window.showAuthModal();
                } else {
                    window.showNotification('❌ ' + (d.message || 'Ошибка'), 'danger');
                }
            })
            .catch(() => window.showNotification('❌ Ошибка соединения', 'danger'));
        };

        window.toggleFavorite = async function(variantId, button) {
            if (!await window.isUserAuthenticated()) {
                window.showAuthModal();
                return;
            }

            const icon = button.querySelector('i');
            const originalClass = icon.className;
            icon.className = 'bi bi-arrow-repeat spin';
            button.disabled = true;

            try {
                const response = await fetch('/FavoriteDish/Add?handler=Toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': window.getAntiForgeryToken()
                    },
                    body: JSON.stringify({ dishVariantId: variantId })
                });
                const data = await response.json();

                if (data.success) {
                    icon.className = data.isFavorite ? 'bi bi-heart-fill' : 'bi bi-heart';
                    button.classList.remove('btn-outline-danger', 'btn-danger');
                    button.classList.add(data.isFavorite ? 'btn-danger' : 'btn-outline-danger');
                    window.showNotification(data.isFavorite ? '❤️ В избранном' : '💔 Удалено', 'success');
                } else {
                    icon.className = originalClass;
                    window.showNotification('❌ ' + (data.message || 'Ошибка'), 'danger');
                }
            } catch (error) {
                icon.className = originalClass;
                window.showNotification('❌ Ошибка соединения', 'danger');
            } finally {
                button.disabled = false;
            }
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
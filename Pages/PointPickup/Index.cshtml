@page
@model MaxFood.Pages.PointPickup.IndexModel
@{
    ViewData["Title"] = "Точки самовывоза";
}

<div class="container mt-4" style="max-width: 1000px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-3 py-1">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
        <i class="bi bi-shop fs-1" style="color: #2c5f2d;"></i>
        <div style="width: 80px;"></div>
    </div>

    <div class="text-center mb-4">
        <h1 class="fw-bold" style="color: #2c5f2d;">Точки самовывоза</h1>
        <p class="text-muted">Заберите свой заказ в удобном месте</p>
    </div>

    <div class="row g-4 justify-content-center">
        @for (int i = 0; i < Model.PointPickupList.Count; i++)
        {
            var point = Model.PointPickupList[i];
            // Если это 5-й элемент (индекс 4) — центрируем
            <div class="col-md-6 @(i == 4 ? "mx-auto" : "")">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-building fs-3 me-2" style="color: #2c5f2d;"></i>
                            <h5 class="card-title fw-bold mb-0" style="color: #2c5f2d;">@point.PointName</h5>
                        </div>
                        <p class="card-text mb-0">
                            <i class="bi bi-geo-alt-fill me-2 text-muted"></i>@point.Address
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@page
@model MaxFood.Pages.Support.EditModel
@{
    ViewData["Title"] = "Редактировать сообщение";
}

<div class="container mt-4" style="background-color: white; padding: 20px; border-radius: 15px; max-width: 500px;">
    <h2 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Редактировать сообщение</h2>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Support.SupportId" />
        <input type="hidden" asp-for="Support.AppUserId" />
        <input type="hidden" asp-for="Support.IsFromUser" />
        <input type="hidden" asp-for="Support.CreatedAt" />

        <div class="mb-3">
            <label asp-for="Support.Text" class="form-label">Сообщение</label>
            <textarea asp-for="Support.Text" class="form-control" rows="4" required></textarea>
            <span asp-validation-for="Support.Text" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Сохранить</button>
            <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@page
@model MaxFood.Pages.Support.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Сообщения";
    var userId = HttpContext.Session.GetString("UserId");
    var requestToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
    var role = HttpContext.Session.GetInt32("UserRole");
    var isAdminOrManager = role == 4 || role == 3;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaxFood</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', -apple-system, sans-serif;
            letter-spacing: -0.2px;
        }

        body {
            background: #f5f7fa;
            margin: 0;
            padding: 20px;
        }

        .chat-container {
            background: white;
            border-radius: 24px;
            border: 1px solid #e9ecef;
            overflow: hidden;
            max-width: 1100px;
            margin: 0 auto;
        }

        .chat-sidebar {
            background: #fcfcfd;
            border-right: 1px solid #e9ecef;
            padding: 16px;
        }

        .chat-main {
            padding: 20px;
        }

        .section-title {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 16px;
            letter-spacing: -0.3px;
            text-align: center;
        }

        .chat-user-item {
            display: block;
            padding: 10px 14px;
            border-radius: 12px;
            margin-bottom: 6px;
            text-decoration: none;
            transition: 0.15s;
        }

            .chat-user-item:hover {
                background: #f1f3f5;
            }

            .chat-user-item.active {
                background: #e8f5e9;
                border-left: 3px solid #28a745;
            }

        .chat-user-name {
            font-weight: 600;
            font-size: 0.85rem;
            color: #2c3e50;
        }

        .chat-user-badge {
            background: #dc3545;
            color: white;
            border-radius: 20px;
            padding: 2px 8px;
            font-size: 0.7rem;
            font-weight: 600;
            float: right;
        }

        .tabs-custom {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 8px;
        }

        .tab-btn {
            flex: 1;
            text-align: center;
            padding: 8px 12px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: 0.15s;
            background: transparent;
            border: none;
            color: #6c757d;
        }

            .tab-btn.active {
                background: #28a745;
                color: white;
            }

            .tab-btn:not(.active):hover {
                background: #f1f3f5;
                color: #2c3e50;
            }

        .message-bubble-client {
            background: #f1f3f5;
            padding: 10px 14px;
            border-radius: 18px;
            max-width: 70%;
        }

            .message-bubble-client p {
                margin-bottom: 0;
            }

            .message-bubble-client .message-time {
                color: #8a99a8;
            }

        .message-bubble-support-reply {
            background: #28a745;
            color: white;
            padding: 10px 14px;
            border-radius: 18px;
            max-width: 70%;
            margin-left: auto;
        }

            .message-bubble-support-reply p {
                color: white;
                margin-bottom: 0;
            }

            .message-bubble-support-reply .message-time {
                color: rgba(255,255,255,0.7);
                text-align: right;
            }

        .message-bubble-my {
            background: #28a745;
            color: white;
            padding: 10px 14px;
            border-radius: 18px;
            max-width: 70%;
            margin-left: auto;
        }

            .message-bubble-my p {
                color: white;
                margin-bottom: 0;
            }

            .message-bubble-my .message-time {
                color: rgba(255,255,255,0.7);
                text-align: right;
            }

        .message-bubble-other {
            background: #f1f3f5;
            padding: 10px 14px;
            border-radius: 18px;
            max-width: 70%;
        }

            .message-bubble-other p {
                margin-bottom: 0;
            }

            .message-bubble-other .message-time {
                color: #8a99a8;
            }

        .input-group-custom {
            display: flex;
            gap: 8px;
            margin-top: 16px;
        }

            .input-group-custom input {
                flex: 1;
                padding: 10px 16px;
                border: 1px solid #dee2e6;
                border-radius: 10px;
                font-size: 0.85rem;
                outline: none;
            }

                .input-group-custom input:focus {
                    border-color: #28a745;
                }

            .input-group-custom button {
                background: #28a745;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 10px 24px;
                font-weight: 600;
                transition: 0.15s;
            }

                .input-group-custom button:hover {
                    background: #1e6b38;
                    transform: translateY(-1px);
                }

        .start-help-btn {
            background: #28a745;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 6px 16px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 10px;
            cursor: pointer;
            transition: 0.15s;
        }

            .start-help-btn:hover {
                background: #1e6b38;
            }

        .empty-chat {
            text-align: center;
            padding: 60px 20px;
            color: #8a99a8;
        }

            .empty-chat i {
                font-size: 64px;
                margin-bottom: 16px;
            }

        .btn-primary {
            background: #28a745;
            border: none;
        }

            .btn-primary:hover {
                background: #1e6b38;
            }

        @@media (max-width: 768px) {
            .chat-sidebar {
                border-right: none;
                border-bottom: 1px solid #e9ecef;
            }
        }
    </style>
</head>
<body>
    <input type="hidden" id="requestVerificationToken" value="@requestToken" />

    <div class="chat-container">
        @if (string.IsNullOrEmpty(userId))
        {
            <div class="text-center py-5">
                <i class="bi bi-person-lock" style="font-size: 64px; color: #adb5bd;"></i>
                <h3 class="fw-bold mt-3" style="font-size: 1.2rem;">Требуется авторизация</h3>
                <p class="text-muted small">Войдите, чтобы видеть сообщения</p>
                <div class="mt-3"><a href="/Authorization/Login" class="btn" style="background: #28a745; color: white; border-radius: 10px; padding: 8px 24px;">Войти</a><a href="/Registration/Register" class="btn btn-outline-secondary rounded-pill ms-2">Регистрация</a></div>
            </div>
        }
        else
        {
            <div class="row g-0">
                <div class="col-md-4 chat-sidebar">
                    @if (isAdminOrManager)
                    {
                        <div class="tabs-custom">
                            <button class="tab-btn @(Model.ActiveTab == "messages" ? "active" : "")" onclick="switchTab('messages')">💬 Сообщения</button>
                            <button class="tab-btn @(Model.ActiveTab == "support" ? "active" : "")" onclick="switchTab('support')">🎧 Поддержка</button>
                        </div>
                    }

                    <input type="text" id="searchUser" class="form-control form-control-sm rounded-pill mb-3" placeholder="Поиск...">

                    <div id="userList">
                        @if (!isAdminOrManager || Model.ActiveTab == "messages")
                        {
                            <a href="?tab=messages&favorite=1" class="chat-user-item @(Model.IsFavoriteTab ? "active" : "")"><i class="bi bi-star me-2"></i><span class="chat-user-name">Избранное</span></a>
                            <a href="?tab=messages&support=1" class="chat-user-item @(Model.IsSupportChat && Model.ActiveTab == "messages" ? "active" : "")"><i class="bi bi-headset me-2"></i><span class="chat-user-name">Поддержка</span>@if(Model.SupportUnreadCount > 0){
                            <span class="chat-user-badge">@Model.SupportUnreadCount</span>
                        }
    </a>

                        @foreach (var user in Model.PersonalChats)
                        {
                            <a href="?tab=messages&userId=@user.AppUserId" class="chat-user-item @(Model.SelectedUserId == user.AppUserId && !Model.IsFavoriteTab && !Model.IsSupportChat && Model.ActiveTab == "messages" ? "active" : "")">
                                <i class="bi bi-person me-2"></i><span class="chat-user-name">@user.FullName</span>
                                @if (user.UnreadCount > 0)
                                {
                                    <span class="chat-user-badge">@user.UnreadCount</span>
                                }
                            </a>
                        }
                    }
                                        else if (isAdminOrManager && Model.ActiveTab == "support")
                    {
                        @foreach (var chat in Model.SupportChats)
                        {
                            <a href="?tab=support&userId=@chat.AppUserId&support=1" class="chat-user-item @(Model.SelectedUserId == chat.AppUserId && Model.IsSupportChat ? "active" : "")">
                                <i class="bi bi-person me-2"></i><span class="chat-user-name">@chat.FullName</span>
                                @if (chat.UnreadCount > 0)
                                {
                                    <span class="chat-user-badge">@chat.UnreadCount</span>
                                }
                            </a>
                        }

                        @if (!Model.SupportChats.Any())
                        {
                            <div class="text-center text-muted small py-3">Нет обращений в поддержку</div>
                        }
                    }
                </div>

                <div class="mt-3 pt-2 border-top"><a href="/Review/Index" class="chat-user-item"><i class="bi bi-star me-2"></i><span class="chat-user-name">Отзывы пользователей</span></a></div>
            </div>

            <div class="col-md-8 chat-main">
                @if (Model.IsFavoriteTab)
                {
                    <div class="fw-bold mb-3">⭐ Избранное</div>
                    <div id="chatMessages" style="max-height: 400px; overflow-y: auto;">
                        @if (Model.FavoriteMessages != null && Model.FavoriteMessages.Any())
                        {
                            @foreach (var msg in Model.FavoriteMessages)
                            {
                                <div class="d-flex justify-content-end mb-3"><div class="message-bubble-my"><p class="mb-0">@msg.Text</p><div class="message-time text-end">@msg.CreatedAt.ToString("dd.MM HH:mm")</div></div></div>
                            }
                        }
                        else
                        {
                            <div class="empty-chat"><i class="bi bi-star"></i><p>Нет заметок</p></div>
                        }
                    </div>
                    <form method="post" asp-page-handler="SendNote" class="input-group-custom">@Html.AntiForgeryToken()<input type="text" name="text" placeholder="Новая заметка..."><button type="submit">Отправить</button></form>
                }
                else if (Model.IsSupportChat)
                {
                    <div class="fw-bold mb-3 d-flex justify-content-between align-items-center">
                        <span>🎧 Чат поддержки — @Model.ChatUserName</span>
                        @if (isAdminOrManager && Model.SelectedUserId.HasValue && Model.SelectedUserId.Value != Model.CurrentUserId && !Model.IsHelpStarted)
                        {
                            <button class="start-help-btn" onclick="startHelp(@Model.SelectedUserId.Value)">Начать диалог</button>
                        }
                    </div>

                    <div id="chatMessages" style="max-height: 400px; overflow-y: auto;">
                        @if (Model.Messages != null && Model.Messages.Any())
                        {
                            @foreach (var msg in Model.Messages)
                            {
                                bool isFromCurrentUser = false;

                                if (!msg.IsFromUser && msg.HelperId == Model.CurrentUserId)
                                {
                                    isFromCurrentUser = true;
                                }
                                else if (msg.IsFromUser && msg.AppUserId == Model.CurrentUserId)
                                {
                                    isFromCurrentUser = true;
                                }

                                if (isFromCurrentUser)
                                {
                                    <div class="d-flex justify-content-end mb-3">
                                        <div class="message-bubble-support-reply">
                                            <small class="fw-bold d-block" style="color: rgba(255,255,255,0.8); font-size: 0.65rem;">
                                                @(msg.IsFromUser ? "Вы" : "Вы (поддержка)")
                                            </small>
                                            <p class="mb-0">@msg.Text</p>
                                            <div class="message-time text-end">@msg.CreatedAt.ToString("dd.MM HH:mm")</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-start mb-3">
                                        <div class="message-bubble-client">
                                            <small class="fw-bold d-block" style="color: #28a745; font-size: 0.65rem;">
                                                @(msg.IsFromUser ? "Пользователь" : "Поддержка")
                                            </small>
                                            <p class="mb-0">@msg.Text</p>
                                            <div class="message-time">@msg.CreatedAt.ToString("dd.MM HH:mm")</div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="empty-chat"><i class="bi bi-chat-dots"></i><p>Напишите ваше сообщение</p></div>
                        }
                    </div>

                    @if (isAdminOrManager && Model.SelectedUserId.HasValue)
                    {
                        <form method="post" asp-page-handler="AdminReply" class="input-group-custom">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.SelectedUserId.Value">
                            <input type="text" name="text" placeholder="Ответ от поддержки..." required>
                            <button type="submit">Отправить как поддержка</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="SendToSupport" class="input-group-custom">
                            @Html.AntiForgeryToken()
                            <input type="text" name="text" placeholder="Сообщение в поддержку..." required>
                            <button type="submit">Отправить</button>
                        </form>
                    }
                }
                else if (Model.SelectedUserId.HasValue)
                {
                    <div class="fw-bold mb-3">👤 @Model.ChatUserName</div>
                    <div id="chatMessages" style="max-height: 400px; overflow-y: auto;">
                        @if (Model.Messages != null && Model.Messages.Any())
                        {
                            @foreach (var msg in Model.Messages)
                            {
                                if (msg.AppUserId == Model.CurrentUserId)
                                {
                                    <div class="d-flex justify-content-end mb-3">
                                        <div class="message-bubble-my">
                                            @if (!msg.IsFromUser && isAdminOrManager)
                                            {
                                                <small class="fw-bold d-block" style="color: rgba(255,255,255,0.8); font-size: 0.65rem;">Вы (поддержка)</small>
                                            }
                                            <p class="mb-0">@msg.Text</p>
                                            <div class="message-time text-end">@msg.CreatedAt.ToString("dd.MM HH:mm")</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-start mb-3">
                                        <div class="message-bubble-other">
                                            @if (msg.IsFromUser && !isAdminOrManager)
                                            {
                                                <small class="fw-bold d-block" style="color: #28a745; font-size: 0.65rem;">Собеседник</small>
                                            }
                                            <p class="mb-0">@msg.Text</p>
                                            <div class="message-time">@msg.CreatedAt.ToString("dd.MM HH:mm")</div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="empty-chat"><i class="bi bi-chat"></i><p>Нет сообщений</p></div>
                        }
                    </div>
                    <form method="post" asp-page-handler="SendMessage" class="input-group-custom">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.SelectedUserId">
                        <input type="text" name="text" placeholder="Сообщение..." required>
                        <button type="submit">Отправить</button>
                    </form>
                }
                else
                {
                    <div class="empty-chat"><i class="bi bi-chat-left-text"></i><p>Выберите чат слева</p></div>
                }
            </div>
        </div>
                }
    </div>

    <script>
        function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }

        function scrollToBottom() { var c = document.getElementById('chatMessages'); if (c) c.scrollTop = c.scrollHeight; }

        function switchTab(tab) {
            const url = new URL(window.location.href);
            url.searchParams.set('tab', tab);
            url.searchParams.delete('userId');
            url.searchParams.delete('support');
            url.searchParams.delete('favorite');
            window.location.href = url.toString();
        }

        async function markAsRead(userId, isSupportChat) {
            if (!userId && !isSupportChat) return;
            await fetch('/Support/Index?handler=MarkAsRead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': getToken() },
                body: JSON.stringify({ userId: userId, isSupportChat: isSupportChat })
            });
        }

        async function startHelp(userId) {
            if (!userId) return;
            const resp = await fetch(`/Support/Index?handler=StartHelp&userId=${userId}`, {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': getToken() }
            });
            if (resp.ok) location.reload();
            else alert('Ошибка');
        }

        document.addEventListener('DOMContentLoaded', function() {
            scrollToBottom();
            const url = new URLSearchParams(window.location.search);
            const userId = url.get('userId');
            const isSupportChat = url.get('support') === '1';
            const tab = url.get('tab') || 'messages';

            if (userId && !isSupportChat && tab === 'messages') markAsRead(parseInt(userId), false);
            if (isSupportChat && tab === 'messages') markAsRead(null, true);
            if (isSupportChat && tab === 'support' && userId) markAsRead(parseInt(userId), true);
        });

        document.getElementById('searchUser')?.addEventListener('input', function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.chat-user-item').forEach(a => {
                a.style.display = !q || a.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        });

        setInterval(async () => {
            const r = await fetch('/Support/Index?handler=UnreadCount');
            const d = await r.json();
            const badge = document.querySelector('a[href*="support=1"] .chat-user-badge');
            if (badge) badge.style.display = d.unreadCount > 0 ? 'inline-block' : 'none';
        }, 5000);
    </script>
</body>
</html>
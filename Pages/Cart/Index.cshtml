@page "/Cart/Index"
@model MaxFood.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Управление корзинами";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-cart-check"></i> Все корзины пользователей</h1>
    <div>
        <a asp-page="/Users/Index" class="btn btn-secondary">
            <i class="bi bi-people"></i> Пользователи
        </a>
        <a asp-page="/Index" class="btn btn-outline-primary">
            <i class="bi bi-house"></i> На главную
        </a>
    </div>
</div>

<div class="table-responsive bg-white shadow-sm rounded p-3">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Пользователь</th>
                <th>Дата создания</th>
                <th>Товаров</th>
                <th>Сумма</th>
                <th>Статус</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Carts.Any())
            {
                @foreach (var item in Model.Carts)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">#@item.CartId</span></td>
                        <td>
                            @if (item.AppUser?.UserProfile != null)
                            {
                                <strong>@($"{item.AppUser.UserProfile.FirstName} {item.AppUser.UserProfile.LastName}")</strong>
                                <div class="small text-muted">@item.AppUser.UserProfile.Email</div>
                            }
                            else
                            {
                                <span class="text-muted">ID: @item.AppUserId</span>
                            }
                        </td>
                        <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.CartItems.Count</td>
                        <td class="fw-bold">@item.TotalAmount.ToString("C")</td>
                        <td><span class="badge bg-success">Активна</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-page="./Details" asp-route-id="@item.CartId" class="btn btn-sm btn-info text-white" title="Просмотр">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.CartId" class="btn btn-sm btn-warning" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-page-handler="Impersonate" asp-route-userId="@item.AppUserId" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-dark" title="Войти под пользователем">
                                        <i class="bi bi-person-badge"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        На данный момент нет активных корзин.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@page
@model MaxFood.Pages.FavoriteDish.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>FavoriteDish</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FavoriteDish.AddedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FavoriteDish.AddedDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FavoriteDish.AppUser)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FavoriteDish.AppUser.PasswordHash)
        </dd>
        <dt class="col-sm-2">
            Вариант блюда
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FavoriteDish.DishVariant.SizeName)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="FavoriteDish.FavoriteDishId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./MyFavoriteDish">Back to List</a>
    </form>
</div>